#!/usr/bin/env python3
"""claude-browser — one Chrome instance per Claude Code session, already signed in.

Why this exists
---------------
The Claude in Chrome extension pairs per Chrome PROFILE and per Claude ACCOUNT.
Running one profile per Claude account inside your everyday Chrome means (a) the
profile is loaded for as long as that Chrome runs, so nothing can safely write
cookies into it, and (b) nothing tells you which Claude session is driving which
browser.

This tool gives each session its own Chrome INSTANCE (own --user-data-dir),
cloned on demand from a shared BASE plus a small per-account pairing OVERLAY.
Because the clone is a fresh, unloaded directory, the cookies the session needs
are copied into it *before* Chrome opens it: the account's claude.ai session from
that account's golden identity (or, without one, its profile in your main Chrome),
and site cookies for the hosts the agent declares. The window, Dock icon and
first tab name the session and its purpose. At session end the instance is deleted.

Layout (under the root, default ~/Library/Application Support/Chrome-Claude/):
  templates/_base/                shared parent: Chrome skeleton + Claude extension, NO identity
  templates/<account>/            the account's pairing (extension local storage) + overlay.json
  templates/<account>/identity/   the account's golden claude.ai login: a never-paired user-data-dir
                                  created fresh (not a base clone); run briefly to refresh
  sessions/acct-<account>/        the account's shared agent browser = clone of _base + pairing + cookies;
                                  instance.json lists the attached agent sessions
  icons/                          generated Dock icons (from your installed Chrome's icon)
  events.log                      append-only record of refusals, launches, attaches, detaches, teardowns
Config: ~/.config/claude-browser/config.json (or $CLAUDE_BROWSER_CONFIG); see `claude-browser config`.

One browser per Claude account, shared by every agent on that account; each
agent works in its own tab group. The last agent to detach (or the reaper:
Chrome gone, every agent's process gone, or idle) tears it down.

Subcommands
  template init               create the base; one human click, once per Mac (Add to Chrome)
  template init --rebuild [--with EXT ...]   build a fresh base beside the old one, swap it in
  template add-extension EXT  add a Web Store extension to the base (one human click)
  template pair <account>     pair an account: base clone signed in from the account's main-Chrome
                              profile; a human clicks the extension once; pairing saved
  template check <account>    base + pairing ready?
  template identity seed <account>|--all     copy the claude.ai login from the main-Chrome profile
  template identity refresh <account>|--all [--if-older-than H]
                              open the identity hidden on claude.ai for a while, quit, record the expiry
  template identity login <account>          sign in to claude.ai in the identity's own window
  template list
  up --purpose W --sites H[,H] [--account A] [--session S] [--origin T] [--no-graft]
                              attach this session to its account's browser, launching it (with ONLY
                              those hosts' cookies + claude.* from the account's profile) if needed
  down [<session>] [--all]    detach a session; the last one out tears the browser down
  list [--json]               browsers and their attached agents (purpose, owner alive, origin)
  resolve <device-id>         which browser/agents own this device id
  events [--since H] [--json] the event log
  gc [--older-than HOURS]     tear down browsers that are dead, abandoned, idle or old; refresh
                              at most one golden identity older than identity_refresh_hours
  app build|check             icon-bearing Chrome copies used for agent instances
  config                      print the effective configuration

Exit codes: 0 ok · 1 usage/precondition · 2 template not ready (human step) ·
3 instance failed to come up.
"""
import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

__version__ = "0.3.1"

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get("CLAUDE_BROWSER_CONFIG",
                             os.path.join(HOME, ".config", "claude-browser", "config.json"))


def _load_config():
    """Optional overrides; every key has a default (see `claude-browser config`)."""
    try:
        with open(CONFIG_PATH) as fh:
            return json.load(fh) or {}
    except (OSError, ValueError):
        return {}


CFG = _load_config()


def _path(key, default):
    v = CFG.get(key)
    return os.path.expanduser(v) if v else default


ROOT = _path("root", os.path.join(HOME, "Library", "Application Support", "Chrome-Claude"))
TEMPLATES = os.path.join(ROOT, "templates")
BASE = os.path.join(TEMPLATES, "_base")        # shared parent: Chrome skeleton + Claude extension, no identity
SESSIONS = os.path.join(ROOT, "sessions")
ICON_DIR = os.path.join(ROOT, "icons")
EVENTS = os.path.join(ROOT, "events.log")
MAIN_CHROME = _path("main_chrome_dir", os.path.join(HOME, "Library", "Application Support", "Google", "Chrome"))
SITE_COOKIE_SOURCE = CFG.get("site_cookie_source") or "Default"   # profile dir in main Chrome holding site logins
CHROME_APP = "Google Chrome"
CHROME_APP_SRC = _path("chrome_app_src", "/Applications/Google Chrome.app")
APPS_DIR = _path("apps_dir", os.path.join(HOME, "Applications"))
# A byte-identical APFS clone of Google Chrome.app with a custom Finder icon, so
# agent browsers get their own Dock icon. The clone keeps Google's signature
# (non-strict verify passes; Keychain hands over "Chrome Safe Storage" without
# a prompt). Rebuild after Chrome updates: `claude-browser app build`.
CHROME_APP_COPY = os.path.join(APPS_DIR, "Chrome Claude.app")
INSTANCE_APPS = os.path.join(APPS_DIR, "Chrome Claude Instances")
REGISTRY = _path("registry", None)
NMH_MAIN = _path("native_messaging_hosts", os.path.join(MAIN_CHROME, "NativeMessagingHosts"))
EXT_CLAUDE = CFG.get("extension_id") or "fcoeoabgfenejglbffodgkkbkcdhcgfn"      # Claude in Chrome (Web Store id)
# anthropic.com is deliberately absent: the Console session there can mint API
# keys and change billing, and the extension does not need it.
CLAUDE_HOSTS = CFG.get("claude_hosts") or ["claude.ai", "*.claude.ai", "claude.com", "*.claude.com",
                                           "claudeusercontent.com", "*.claudeusercontent.com"]
ALLOWED_SITES = [x.lower() for x in (CFG.get("allowed_sites") or [])]
DENIED_SITES = [x.lower() for x in (CFG.get("denied_sites") or [])]
GRAFTER = _path("grafter", None) or shutil.which("chrome-cookie-graft") or "chrome-cookie-graft"
ICON_MAKER = os.path.join(os.path.dirname(os.path.realpath(__file__)), "make-claude-chrome-icon")
LSOF = "/usr/sbin/lsof"
TRASH = shutil.which("trash")


def effective_config():
    return {
        "config_file": CONFIG_PATH + ("" if os.path.exists(CONFIG_PATH) else " (absent: all defaults)"),
        "root": ROOT,
        "main_chrome_dir": MAIN_CHROME,
        "site_cookie_source": SITE_COOKIE_SOURCE,
        "accounts": accounts_map(),
        "registry": REGISTRY,
        "account_detector": CFG.get("account_detector"),
        "origin_command": CFG.get("origin_command"),
        "extension_id": EXT_CLAUDE,
        "chrome_app_src": CHROME_APP_SRC,
        "apps_dir": APPS_DIR,
        "native_messaging_hosts": NMH_MAIN,
        "idle_minutes": IDLE_MINUTES,
        "owner_process_names": sorted(OWNER_NAMES),
        "identity_refresh_hours": IDENTITY_REFRESH_HOURS,
        "identity_refresh_seconds": IDENTITY_REFRESH_SECONDS,
        "grafter": GRAFTER,
        "claude_hosts": CLAUDE_HOSTS,
        "allowed_sites": ALLOWED_SITES or None,
        "denied_sites": DENIED_SITES or None,
    }


# ----------------------------------------------------------------- accounts

def _account_entries():
    """config `accounts`: {"<account>": "<profile dir>"} or
    {"<account>": {"profile": "<profile dir>", "badge": "W"}}."""
    out = {}
    for name, v in (CFG.get("accounts") or {}).items():
        out[name] = {"profile": v} if isinstance(v, str) else dict(v or {})
    return out


def _registry_accounts():
    """Optional fallback for setups that already keep an account registry:
    a JSON file with accounts.<name>.chrome_profile_dir."""
    if not REGISTRY:
        return {}
    reg = read_json(REGISTRY, {}) or {}
    return {k: (v or {}).get("chrome_profile_dir") for k, v in (reg.get("accounts") or {}).items()}


def accounts_map():
    """account → main-Chrome profile dir; config first, registry second."""
    m = {k: v for k, v in _registry_accounts().items() if v}
    for k, v in _account_entries().items():
        if v.get("profile"):
            m[k] = v["profile"]
    return m


def main_chrome_profile_for(account):
    """Which profile dir inside the main Chrome is signed in to claude.ai as this account?"""
    return accounts_map().get(account)


def known_accounts():
    names = set(accounts_map()) | set(_account_entries())   # `{}` entries: golden identity only
    if os.path.isdir(TEMPLATES):
        names |= {a for a in os.listdir(TEMPLATES) if not a.startswith((".", "_"))
                  and os.path.isdir(os.path.join(TEMPLATES, a))}
    return sorted(n for n in names if NAME_RE.fullmatch(n) and ".." not in n)


def account_badge(account):
    """Short tag drawn on the account's Dock icon disc: config `badge`, else
    "C" + the digits in the name (team2 → C2), else the first two letters."""
    b = (_account_entries().get(account) or {}).get("badge")
    if b:
        return str(b)[:3]
    digits = re.sub(r"\D", "", account)
    return ("C" + digits) if digits else (account[:2].upper() or "?")


def account_suffix(account):
    """Name part of the per-account app copy: 'Chrome Claude <suffix>.app'."""
    return re.sub(r"\D", "", account) or re.sub(r"[^A-Za-z0-9_-]+", "-", account)


def session_account():
    """Which Claude account is this CLI session? $CLAUDE_BROWSER_ACCOUNT, then the
    config `account_detector` command (its stdout's first word), else unknown."""
    env = os.environ.get("CLAUDE_BROWSER_ACCOUNT")
    if env:
        return env.strip()
    det = CFG.get("account_detector")
    if det:
        # shell=True on purpose: the command comes from the user's own config file
        # (same trust as the file) and is meant to allow pipelines.
        r = subprocess.run(det, shell=True, capture_output=True, text=True)  # nosec B602
        words = r.stdout.split()
        if r.returncode == 0 and words:
            return words[0]
    return None


# ----------------------------------------------------------------- helpers

def log_event(kind, **fields):
    """Append-only JSONL record of every launch, refusal, pairing and teardown.
    Instances delete themselves on teardown, so this is the only durable
    trace of who used a browser, for what, and whether it worked."""
    rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "event": kind,
           "cli_session": os.environ.get("CLAUDE_SESSION_ID"), "pid": os.getpid()}
    rec.update(fields)
    try:
        os.makedirs(ROOT, exist_ok=True)
        with open(EVENTS, "a") as fh:
            fh.write(json.dumps(rec, sort_keys=True) + "\n")
    except OSError:
        pass


def die(msg, code=1, **fields):
    if fields:
        log_event("refused", reason=msg.splitlines()[0][:160], code=code, **fields)
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(code)


# Session ids and account names become directory names under the root, and
# teardown deletes those directories: anything that could climb out of the
# root (absolute paths, "..", separators) is refused at the door.
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def check_name(kind, value):
    # fullmatch: `$` would accept a trailing newline. Session ids must be
    # lowercase too: APFS is case-insensitive, so `down ABC` would resolve to
    # the dir `abc` while the exact-case process match found nothing to stop.
    ok = bool(value) and NAME_RE.fullmatch(value) and ".." not in value
    if ok and kind == "session" and value != value.lower():
        ok = False
    if not ok:
        rule = "lowercase letters, digits" if kind == "session" else "letters, digits"
        die(f"refusing {kind} {value!r}: use {rule}, '.', '_' or '-' (max 64, no '..')")
    return value


def tdir(account):
    return os.path.join(TEMPLATES, check_name("account", account))


def sdir(session):
    return os.path.join(SESSIONS, check_name("session", session))


def inside(path, parent):
    """True if PATH resolves to a direct child of PARENT (no symlink escape)."""
    return os.path.dirname(os.path.realpath(path)) == os.path.realpath(parent)


def read_json(path, default=None):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def write_json(path, obj):
    """Atomic: readers outside the lock never see a half-written file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        json.dump(obj, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def grafter_ok():
    return bool(shutil.which(GRAFTER) or os.access(GRAFTER, os.X_OK))


def cookies_db(user_data_dir):
    for p in (os.path.join(user_data_dir, "Default", "Cookies"),
              os.path.join(user_data_dir, "Default", "Network", "Cookies")):
        if os.path.exists(p):
            return p
    return None


def is_open(user_data_dir):
    """True if some Chrome process has this user-data-dir's cookie DB open."""
    db = cookies_db(user_data_dir)
    if not db:
        return False
    return subprocess.run([LSOF, db], capture_output=True).returncode == 0


def chrome_pids(user_data_dir):
    """PIDs whose command line carries exactly --user-data-dir=<dir> (followed by
    a space or the end), compared as plain text: no regex, so a session that is
    a prefix of another, or a root path with regex metacharacters, can't match
    the wrong instance."""
    flag = f"--user-data-dir={user_data_dir}"
    out = subprocess.run(["ps", "-axww", "-o", "pid=,command="], capture_output=True, text=True).stdout
    pids = []
    for line in out.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        i = cmd.find(flag)
        while i != -1:
            end = i + len(flag)
            if (end == len(cmd) or cmd[end] == " ") and (i == 0 or cmd[i - 1] == " "):
                if pid.isdigit() and int(pid) != os.getpid():
                    pids.append(int(pid))
                break
            i = cmd.find(flag, i + 1)
    return pids


def kill_instance(user_data_dir, sig=15):
    for pid in chrome_pids(user_data_dir):
        try:
            os.kill(pid, sig)
        except OSError:
            pass


def ext_settings(user_data_dir, ext=EXT_CLAUDE):
    return os.path.join(user_data_dir, "Default", "Local Extension Settings", ext)


def device_id(user_data_dir):
    return device_id_in_store(ext_settings(user_data_dir))


# An account's saved pairing (the extension's local storage after one human
# click) is slot 1 at templates/<account>/. The shared per-account browser uses
# slot 1. The slot helpers also read templates/<account>/slots/<n>/ for n > 1;
# nothing in 0.2.0 creates those.
def slot_root(account, n):
    return tdir(account) if int(n) == 1 else os.path.join(tdir(account), "slots", str(int(n)))


def slot_store(account, n):
    return os.path.join(slot_root(account, n), "Local Extension Settings", EXT_CLAUDE)


def slot_meta_path(account, n):
    return os.path.join(slot_root(account, n), "overlay.json")


def account_slots(account):
    """{slot number: device id} for every paired slot of the account."""
    nums = [1]
    sd = os.path.join(tdir(account), "slots")
    if os.path.isdir(sd):
        nums += [int(n) for n in os.listdir(sd) if n.isdigit() and int(n) > 1]
    out = {}
    for n in sorted(set(nums)):
        dev = device_id_in_store(slot_store(account, n))
        if dev:
            out[n] = dev
    return out


SETTLE_HOURS = 10 / 60     # a claimed-but-not-yet-launched instance holds its slot this long
IDLE_MINUTES = float(CFG.get("idle_minutes", 120) or 0)   # 0 = never reap for idleness


class slot_lock:
    """Serialize slot allocation across concurrent `up` calls (flock on root)."""
    def __enter__(self):
        import fcntl
        os.makedirs(ROOT, exist_ok=True)
        self.fh = open(os.path.join(ROOT, "slots.lock"), "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        import fcntl
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


OWNER_NAMES = set(CFG.get("owner_process_names") or ["claude"])
# The golden claude.ai identity (templates/<account>/identity/): `gc` refreshes
# one whose last refresh is older than this (0 = never), keeping its Chrome open
# for identity_refresh_seconds so claude.ai can load.
IDENTITY_REFRESH_HOURS = float(CFG.get("identity_refresh_hours", 24) or 0)
IDENTITY_REFRESH_SECONDS = max(0.0, float(CFG.get("identity_refresh_seconds", 90)))


def owner_pid():
    """PID of the agent process this command runs under (nearest ancestor whose
    name is in config `owner_process_names`, default `claude`), so an instance
    can be reaped when its session is gone."""
    pid = os.getppid()
    for _ in range(12):
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True).stdout.split(None, 1)
        if len(out) < 2:
            return None
        if os.path.basename(out[1].strip()) in OWNER_NAMES:
            return pid
        pid = int(out[0])
        if pid <= 1:
            return None
    return None


def owner_alive(pid):
    if not pid:
        return None
    out = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    return os.path.basename(out) in OWNER_NAMES


def last_activity(d):
    """Newest write Chrome makes as tabs load and navigate (session files, history)."""
    # Not Preferences: Chrome rewrites it on its own, which would hide idleness.
    cands = [os.path.join(d, "instance.json"), os.path.join(d, "Default", "History")]
    sess = os.path.join(d, "Default", "Sessions")
    if os.path.isdir(sess):
        cands += [os.path.join(sess, f) for f in os.listdir(sess)]
    times = []
    for c in cands:
        try:
            times.append(os.path.getmtime(c))
        except OSError:
            pass
    return max(times) if times else None


def attachments(meta):
    """Sessions using an instance. Instances from 0.1.x (one per session, no
    `attached` list) count as attached by their own session."""
    a = meta.get("attached")
    if a is None:
        return [{"session": meta.get("session"), "purpose": meta.get("purpose"), "sites": meta.get("sites") or [],
                 "identity": meta.get("identity") or {}, "owner_pid": meta.get("owner_pid")}]
    if not isinstance(a, list):
        return []
    return [x for x in a if isinstance(x, dict) and isinstance(x.get("session"), str)]


def reap_reason(m):
    """Why an instance should go, or None. dead: Chrome gone. owner-gone:
    every attached agent's process has exited (no SessionEnd detach).
    unattached: no agent left. idle: no browser activity for idle_minutes."""
    settling = not m.get("pid") and (m.get("age_hours") or 0) < SETTLE_HOURS
    if not m["running"]:
        return None if settling else "dead"
    att = m.get("attachments") or []
    if m.get("attached") is not None and not att and m.get("pid"):
        return "unattached"
    if att and all(x.get("owner_pid") and x.get("owner_alive") is False for x in att):
        return "owner-gone"
    if IDLE_MINUTES and (m.get("idle_minutes") or 0) >= IDLE_MINUTES and not held(m):
        return "idle"
    return None


HOLD_MAX_MINUTES = 24 * 60


def held(m):
    """An attached agent declared a long wait (`up --hold N`, e.g. for a human
    sign-in): the idle reaper leaves the browser alone until that time."""
    now = time.time()
    return any((x.get("hold_until") or 0) > now and x.get("owner_alive") is not False
               for x in m.get("attachments") or [])


def prune_attachments():
    """Drop attachments whose agent process has exited (crashed sessions never
    run their SessionEnd detach). Caller holds slot_lock."""
    for m in instances():
        if m.get("attached") is None:
            continue
        gone = [x for x in m["attachments"] if x.get("owner_pid") and x.get("owner_alive") is False]
        if gone and len(gone) < len(m["attachments"]):
            keep = [x["session"] for x in m["attachments"] if x not in gone]
            update_meta(m["dir"], lambda meta: meta.__setitem__(
                "attached", [x for x in meta.get("attached", []) if x.get("session") in keep]))
            for x in gone:
                log_event("detach", session=x.get("session"), instance=m["session"], by="owner-gone")
            rewrite_card(m["dir"])


def update_meta(d, fn):
    """Read-modify-write instance.json (caller holds slot_lock when other
    sessions may write it too)."""
    path = os.path.join(d, "instance.json")
    meta = read_json(path, {}) or {}
    fn(meta)
    write_json(path, meta)
    return meta


def rewrite_card(d):
    meta = read_json(os.path.join(d, "instance.json"), None)
    if meta:
        write_instance_card(d, meta)


def reap(by):
    n = 0
    prune_attachments()
    for m in instances():
        why = reap_reason(m)
        if why and teardown(m["session"], by=f"{by}-{why}"):
            print(f"  reaped {m['session']} ({why})")
            n += 1
    return n


def device_id_in_store(store):
    """Scrape bridgeDeviceId out of the Claude extension's LevelDB. Newest file
    last, last match wins (LevelDB keeps superseded records until compaction)."""
    if not os.path.isdir(store):
        return None
    files = sorted((os.path.join(store, f) for f in os.listdir(store)
                    if f.endswith((".log", ".ldb"))), key=os.path.getmtime)
    found = None
    for f in files:
        try:
            raw = open(f, "rb").read().decode("latin-1")
        except OSError:
            continue
        for m in re.finditer(r"bridgeDeviceId.{0,48}?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", raw, re.S):
            found = m.group(1)
    return found


def extension_installed(user_data_dir, ext):
    return os.path.isdir(os.path.join(user_data_dir, "Default", "Extensions", ext))


def _db_has_claude_session(db):
    """A live claude.ai sessionKey (exact host, not expired), from a copy of a
    Cookies DB (the live one is locked). Nothing is decrypted."""
    return _db_session_expiry(db)[0]


def main_profile_cookies(account):
    src = main_chrome_profile_for(account)
    if not src:
        return src, None
    db = None
    for cand in (os.path.join(MAIN_CHROME, src, "Cookies"), os.path.join(MAIN_CHROME, src, "Network", "Cookies")):
        if os.path.exists(cand):
            db = cand
    return src, db


def main_profile_has_session(account):
    src, db = main_profile_cookies(account)
    if not src:
        return None
    return bool(db and _db_has_claude_session(db))


# ------------------------------------------------------------------- origin

def caller_identity(origin=None):
    """Where the launching agent lives, so a human can find it. Order: --origin,
    config `origin_command`, a herdr pane, a tmux pane, else the tty ("bare").
    Read from the agent's own environment only: asking a multiplexer for its
    *current* pane from outside returns the focused pane, i.e. someone else's."""
    ident = {"host": os.uname().nodename.split(".")[0], "kind": "bare",
             "pane": None, "tab": None, "workspace": None, "target": None}
    env = os.environ
    if not origin and CFG.get("origin_command"):
        r = subprocess.run(CFG["origin_command"], shell=True, capture_output=True, text=True)  # nosec B602
        if r.returncode == 0 and r.stdout.strip():
            origin = r.stdout.strip().splitlines()[0]
    if origin:
        ident.update(kind="custom", pane=origin.strip()[:64])
    elif env.get("HERDR_ENV") == "1" and env.get("HERDR_PANE_ID"):
        ident.update(kind="herdr", pane=env.get("HERDR_PANE_ID"),
                     tab=env.get("HERDR_TAB_ID"), workspace=env.get("HERDR_WORKSPACE_ID"))
        if shutil.which("herdr"):
            r = subprocess.run(["herdr", "pane", "get", ident["pane"]], capture_output=True, text=True)
            try:
                pane = json.loads(r.stdout)["result"]["pane"]
                ident["tab"] = pane.get("tab_id") or ident["tab"]
                ident["workspace"] = pane.get("workspace_id") or ident["workspace"]
                ident["title"] = pane.get("title")
            except Exception:
                pass
        ident["target"] = f"herdr pane read {ident['pane']}"
    elif env.get("TMUX") and env.get("TMUX_PANE"):
        ident.update(kind="tmux", pane=env["TMUX_PANE"])
        r = subprocess.run(["tmux", "display", "-p", "-t", env["TMUX_PANE"], "#S:#I.#P #W"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            loc, _, win = r.stdout.strip().partition(" ")
            ident.update(tab=win, workspace=loc.split(":")[0], tmux_target=loc)
        ident["target"] = f"tmux capture-pane -p -t {ident.get('tmux_target') or ident['pane']}"
    else:
        try:
            ident["pane"] = os.ttyname(0)
        except OSError:
            pass
    return ident


# -------------------------------------------------------------- icons, apps

def app_version(path):
    try:
        import plistlib
        with open(os.path.join(path, "Contents", "Info.plist"), "rb") as fh:
            return plistlib.load(fh).get("CFBundleShortVersionString")
    except Exception:
        return None


def app_copy_path(account=None):
    """<apps_dir>/Chrome Claude <n>.app for an account, else the generic copy."""
    if account:
        p = os.path.join(APPS_DIR, f"Chrome Claude {account_suffix(account)}.app")
        if os.path.isdir(p):
            return p
    return CHROME_APP_COPY


def chrome_app_for_launch(account=None):
    """Prefer the icon-bearing copy (per-account if built) when it matches the
    installed Chrome version; otherwise the stock app (and say so)."""
    p = app_copy_path(account)
    if os.path.isdir(p):
        if app_version(p) == app_version(CHROME_APP_SRC):
            return p
        print(f"  note: {p} is version {app_version(p)} but Chrome is {app_version(CHROME_APP_SRC)}; "
              f"run `claude-browser app build` — launching the stock app for now")
    return CHROME_APP


def make_icon(out, account=None, label=None, sublabel=None):
    """Render an .icns from the installed Chrome's own icon (nothing is shipped).
    Needs Pillow: via `uv run --with pillow` when uv is installed, else python3."""
    runner = ["uv", "run", "--quiet", "--with", "pillow"] if shutil.which("uv") else ["python3"]
    cmd = runner + [ICON_MAKER, out, "--base", os.path.join(CHROME_APP_SRC, "Contents", "Resources", "app.icns")]
    if account:
        cmd += ["--account", account, "--badge", account_badge(account)]
    if label:
        cmd += [f"--label={label}"]
    if sublabel:
        cmd += [f"--sublabel={sublabel}"]
    os.makedirs(os.path.dirname(out), exist_ok=True)
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.returncode == 0 and os.path.isfile(out), (r.stderr or r.stdout).strip()


DOCK_APPS = os.path.join(ROOT, "dock-apps.json")


def _dock_apps():
    """dock-apps.json: a list of paths. Anything else is ignored (gc then removes nothing)."""
    v = read_json(DOCK_APPS, [])
    return [x for x in v if isinstance(x, str)] if isinstance(v, list) else []


def _remember_dock_app(path):
    """Record a Dock app this root created. gc only ever removes apps on this
    list: apps_dir can be shared by several roots (a test root, a second
    config), and an app another root is running must never look orphaned."""
    try:
        apps = set(_dock_apps())
        apps.add(path)
        write_json(DOCK_APPS, sorted(apps))
    except OSError:
        pass


def build_instance_app(user_data_dir, account, purpose, identity, session):
    """One app copy per instance so the Dock shows WHAT it does and WHERE it is
    driven from: icon = account disc + purpose plate + origin line; app name =
    '<badge> <purpose> <origin> <session8>' (Dock hover). APFS clone of Google
    Chrome (instant, copy-on-write); removed at teardown. Falls back to the
    per-account copy if the icon cannot be rendered."""
    if not shutil.which("fileicon"):
        return None
    pane = (identity or {}).get("pane") or ""
    kind = (identity or {}).get("kind") or "bare"
    where = ((identity or {}).get("tmux_target") or pane) if kind in ("herdr", "tmux", "custom") and pane else "bare"
    safe = lambda t: re.sub(r"[^A-Za-z0-9:_.-]+", "-", t)
    path = os.path.join(INSTANCE_APPS, f"{account_badge(account)} {safe(purpose)} {safe(where)} {session[:8]}.app")
    os.makedirs(INSTANCE_APPS, exist_ok=True)
    if os.path.isdir(path):
        shutil.rmtree(path, ignore_errors=True)
    r = subprocess.run(["cp", "-Rc", CHROME_APP_SRC, path], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    icon = os.path.join(user_data_dir, "instance-icon.icns")
    ok, _ = make_icon(icon, account=account, label=purpose, sublabel=where)
    if not ok:
        shutil.rmtree(path, ignore_errors=True)
        return None
    subprocess.run(["fileicon", "set", path, icon], capture_output=True)
    _remember_dock_app(path)
    return path


def launch(user_data_dir, urls=(), account=None, app=None):
    args = ["open", "-na", app or chrome_app_for_launch(account), "--args",
            f"--user-data-dir={user_data_dir}",
            "--profile-directory=Default",
            "--no-first-run", "--no-default-browser-check",
            "--disable-session-crashed-bubble", "--hide-crash-restore-bubble"]
    if urls is not None:
        args += list(urls) or ["about:blank"]
    subprocess.run(args, check=False)


def set_profile_name(user_data_dir, name):
    """Chrome shows profile.name in the window's avatar button and tab strip.
    profile.name is in Preferences (not Secure Preferences), so editing it
    before launch does not trip the settings-reset HMAC."""
    pref = os.path.join(user_data_dir, "Default", "Preferences")
    p = read_json(pref, {}) or {}
    p.setdefault("profile", {})["name"] = name
    p["profile"]["using_default_name"] = False
    write_json(pref, p)


def wait_for_device_id(user_data_dir, timeout=25):
    t0 = time.time()
    while time.time() - t0 < timeout:
        d = device_id(user_data_dir)
        if d:
            return d
        time.sleep(1)
    return None


# --------------------------------------------------------------- templates

EXT_ID_RE = re.compile(r"^[a-p]{32}$")      # Chrome Web Store extension ids
NEW_BASE = BASE + ".new"


class base_build_lock:
    """One `template add-extension` / `template init --rebuild` at a time: both
    build in templates/_base.new. Non-blocking: a second run is refused."""
    def __enter__(self):
        import fcntl
        os.makedirs(ROOT, exist_ok=True)
        self.fh = open(os.path.join(ROOT, "base-build.lock"), "w")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            self.fh.close()
            die("another `template add-extension` or `template init --rebuild` is running; let it finish")
        return self

    def __exit__(self, *exc):
        import fcntl
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def _prepare_new_base():
    """An empty slot for the new base. A leftover _base.new is from a failed
    run (base_build_lock is held): removed, if it is a plain dir and closed."""
    if os.path.lexists(NEW_BASE):
        if os.path.islink(NEW_BASE) or not os.path.isdir(NEW_BASE) or not inside(NEW_BASE, TEMPLATES):
            die(f"refusing: {NEW_BASE} is not a plain directory in {TEMPLATES}; move it aside")
        if chrome_pids(NEW_BASE):
            die(f"a Chrome window is open on {NEW_BASE}; quit it, then rerun")
        shutil.rmtree(NEW_BASE)
    return NEW_BASE


def _run_base_window(new, urls, wait, steps):
    """Open Chrome on NEW and wait for the human to quit it. No early exit
    before Chrome is up: a slow start must not look like a finished window."""
    launch(new, urls, app=CHROME_APP)
    print(steps + f"\nWaiting up to {wait}s…")
    t0 = time.time()
    while not chrome_pids(new) and time.time() - t0 < 60:
        time.sleep(0.5)
    if not chrome_pids(new):
        die(f"Chrome did not start on {new}; nothing changed", 3)
    while chrome_pids(new) and time.time() - t0 < wait:
        time.sleep(2)
    if chrome_pids(new):
        die(f"the window is still open after {wait}s; quit it, then rerun this command (nothing changed)", 3)
    for _ in range(40):
        if not is_open(new):
            break
        time.sleep(0.5)


def _base_problems(d, exts):
    """Why D cannot be the base: a missing extension, a pairing, stray Claude cookies."""
    out = []
    missing = [e for e in exts if not extension_installed(d, e)]
    if missing:
        out.append("extension(s) not installed: " + ", ".join(missing))
    if device_id(d):
        out.append("the Claude extension paired in that window (a base holds no pairing; don't click it)")
    probs = base_cookie_problems(cookie_census(d), bool(cookies_db(d)))
    if probs:
        out.append("it holds " + "; ".join(probs) + " (sign in to nothing in that window; extension setup "
                   "such as connecting a password manager to its desktop app is fine)")
    return out


def _swap_in_base(new, extensions, how):
    """Swap NEW in as the base under slot_lock (so `up` never clones half a
    base), with rollback if the second rename fails; the old base is trashed."""
    old = None
    with slot_lock():
        if os.path.isdir(BASE) and is_open(BASE):
            die("the base is open in Chrome; quit it, then rerun (nothing changed)")
        tj = read_json(os.path.join(new, "template.json"), {}) or {}
        tj.update(kind="base", extensions=sorted(set(extensions)), updated=time.strftime("%Y-%m-%d %H:%M:%S"),
                  how=how)
        tj.setdefault("created", tj["updated"])
        write_json(os.path.join(new, "template.json"), tj)
        if os.path.lexists(BASE):
            old = BASE + time.strftime(".old-%Y%m%d%H%M%S")
            os.rename(BASE, old)
        try:
            os.rename(new, BASE)
        except OSError as e:
            if old:
                os.rename(old, BASE)
            die(f"could not swap in the new base ({e}); the old base is back in place", 3)
    if old:
        # The replaced base is disposable: the new one has passed its checks.
        # Deleted outright (not trashed), like ended session clones.
        if inside(old, TEMPLATES):
            shutil.rmtree(old, ignore_errors=True)


def cmd_template_add_extension(ext, wait=900):
    """Add a Web Store extension (e.g. a password manager) to the shared base,
    so every agent browser launched afterwards has it. One human step: Add to
    Chrome in the window this opens, finish the extension's own setup there if
    it asks (e.g. connect it to its desktop app), then Cmd-Q. The new base is
    built beside the old one (a clone) and swapped in under the lock, so a
    concurrent `up` never clones a half-built base. Running browsers keep
    theirs until they are relaunched."""
    if not EXT_ID_RE.fullmatch(ext or ""):
        die(f"{ext!r} is not a Chrome Web Store extension id (32 letters a-p)")
    bs = base_status()
    if not bs.get("ready"):
        die("base not ready: " + "; ".join(base_not_ready_reasons(bs)), 2)
    if extension_installed(BASE, ext):
        print(f"base already has extension {ext}")
        return 0
    exts = sorted(set(((read_json(os.path.join(BASE, "template.json"), {}) or {}).get("extensions") or [])
                      + [EXT_CLAUDE, ext]))
    with base_build_lock():
        new = _prepare_new_base()
        clone_base(new)
        _run_base_window(new, [f"https://chromewebstore.google.com/detail/{ext}"], wait, """HUMAN STEPS, in the new Chrome window:
  1. Add to Chrome → Add extension.
  2. If the extension asks for setup (e.g. connect to its desktop app), do it. Sign in to nothing else.
  3. Quit that window (Cmd-Q).""")
        problems = _base_problems(new, [EXT_CLAUDE, ext])
        if problems:
            shutil.rmtree(new, ignore_errors=True)
            log_event("base-extension-refused", extension=ext, problems=problems)
            die("nothing changed: " + "; ".join(problems), 3)
        _swap_in_base(new, exts, f"add-extension {ext}")
    log_event("base-extension-added", extension=ext)
    print(f"base now has extension {ext}; browsers launched from now on include it "
          f"(running ones get it when they are next launched)")
    return 0


def cmd_template_rebuild(with_exts=(), wait=900):
    """Rebuild the base from nothing: an empty user-data-dir (not a clone, so it
    inherits no cookie, login or pairing), opened at the Web Store page of the
    Claude extension and of each --with extension. The human adds them all,
    does any extension setup, and quits. Verified (every extension installed,
    no pairing, no Claude cookie), then swapped in under the lock."""
    for e in with_exts:
        if not EXT_ID_RE.fullmatch(e or ""):
            die(f"{e!r} is not a Chrome Web Store extension id (32 letters a-p)")
    exts = [EXT_CLAUDE] + [e for e in dict.fromkeys(with_exts) if e != EXT_CLAUDE]
    with base_build_lock():
        new = _prepare_new_base()
        os.makedirs(os.path.join(new, "Default"))
        ensure_native_hosts(new)
        set_profile_name(new, "claude-browser base")
        names = "Claude in Chrome" + (f" and {len(exts) - 1} more" if len(exts) > 1 else "")
        _run_base_window(new, [f"https://chromewebstore.google.com/detail/{e}" for e in exts], wait,
                         f"""HUMAN STEPS, in the new Chrome window ({len(exts)} tab(s): {names}):
  1. In each tab: Add to Chrome → Add extension. Do NOT click the Claude extension's icon.
  2. Do any extension setup (e.g. connect a password manager to its desktop app). Sign in to no website.
  3. Quit that window (Cmd-Q).""")
        problems = _base_problems(new, exts)
        if problems:
            shutil.rmtree(new, ignore_errors=True)
            log_event("base-rebuild-refused", extensions=exts, problems=problems)
            die("the old base is unchanged: " + "; ".join(problems), 3)
        _swap_in_base(new, exts, "rebuild")
    log_event("base-rebuilt", extensions=exts)
    print(f"base rebuilt with {len(exts)} extension(s): {', '.join(exts)}; browsers launched from now on use it")
    return 0


def cmd_template_init():
    """Create the shared BASE: a fresh Chrome profile with the Claude extension
    installed and nothing else. One human step, once per Mac: Add to Chrome."""
    if os.path.isdir(os.path.join(BASE, "Default")) and extension_installed(BASE, EXT_CLAUDE):
        print(f"base already exists with the extension: {BASE}")
        reasons = base_not_ready_reasons(base_status())
        if reasons:
            print("  but it is NOT ready: " + "; ".join(reasons))
            return 2
        return 0
    os.makedirs(os.path.join(BASE, "Default"), exist_ok=True)
    write_json(os.path.join(BASE, "template.json"), {
        "kind": "base", "created": time.strftime("%Y-%m-%d %H:%M:%S"), "extensions": [EXT_CLAUDE]})
    ensure_native_hosts(BASE)
    set_profile_name(BASE, "claude-browser base")
    launch(BASE, [f"https://chromewebstore.google.com/detail/{EXT_CLAUDE}"])
    print(f"""Opened a fresh Chrome instance on {BASE}

HUMAN STEPS (once per Mac):
  1. Add to Chrome — Claude in Chrome. Do NOT sign in to anything.
  2. Install nothing else. Quit this Chrome instance (Cmd-Q in that window).
Then:  claude-browser template pair <account>   for each account.""")
    return 0


def base_status():
    st = {"dir": BASE, "exists": os.path.isdir(os.path.join(BASE, "Default"))}
    if not st["exists"]:
        return st
    st["claude_extension"] = extension_installed(BASE, EXT_CLAUDE)
    st["open"] = is_open(BASE)
    extdir = os.path.join(BASE, "Default", "Extensions")
    st["extension_count"] = len([e for e in os.listdir(extdir) if not e.startswith(".")]) if os.path.isdir(extdir) else 0
    st["stray_pairing"] = device_id(BASE)   # must be None: identity never lives in the base
    # Must be zero: every clone starts with the base's cookies, so a Claude
    # cookie here (a login) would sign every browser and identity in as someone.
    c = cookie_census(BASE)
    problems = base_cookie_problems(c, bool(cookies_db(BASE)))
    c = c or {"claude_rows": 0, "session_key_rows": 0}
    st["stray_cookies"] = {"claude_rows": c["claude_rows"], "session_key_rows": c["session_key_rows"],
                           "problems": problems}
    st["clean"] = not problems
    st["ready"] = bool(st["claude_extension"] and not st["open"] and st["clean"])
    return st


def base_not_ready_reasons(bs):
    if not bs.get("exists"):
        return ["no base template (claude-browser template init)"]
    why = []
    if not bs.get("claude_extension"):
        why.append("Claude in Chrome extension not installed in the base (claude-browser template init)")
    if bs.get("open"):
        why.append("base is open in Chrome (quit that instance)")
    if not bs.get("clean", True):
        sc = bs.get("stray_cookies") or {}
        why.append(f"the base holds {'; '.join(sc.get('problems') or ['stray cookies'])}: rebuild the base: "
                   f"claude-browser template init --rebuild")
    return why


def base_clean_note():
    """For "clone keeps none" messages: true only if the base is clean."""
    bs = base_status()
    if bs.get("clean", True):
        return "base clean"
    return "WARNING: " + base_not_ready_reasons(bs)[-1]


def template_status(account):
    """An account is ready when the shared base is ready and the account has a
    pairing overlay with a device id. Its claude.ai session comes from the
    account's golden identity (else its main-Chrome profile) at every launch
    (informational here)."""
    bs = base_status()
    d = tdir(account)
    slots = account_slots(account)
    st = {"account": account, "dir": d, "exists": bool(slots), "base": bs, "slots": slots}
    st["device_id"] = next(iter(slots.values()), None)
    st["identity"] = identity_status(account)
    st["main_session"] = main_profile_has_session(account)
    # Whether clones will be signed in: the golden identity wins when it exists.
    st["claude_session"] = st["identity"]["session"] if st["identity"]["exists"] else st["main_session"]
    st["claude_extension"] = bs.get("claude_extension", False)
    st["open"] = bs.get("open", False)
    meta = read_json(os.path.join(d, "overlay.json"), {}) or {}
    st["paired"] = meta.get("paired")
    st["ready"] = bool(bs.get("ready") and st["device_id"])
    return st


def cmd_template_check(account):
    st = template_status(account)
    bs = st["base"]
    if not bs.get("exists"):
        die("no base template: run  claude-browser template init", 2)
    for k in ("claude_extension", "open", "extension_count", "stray_pairing", "stray_cookies"):
        print(f"  base {k:20} {bs.get(k)}")
    for k in ("exists", "paired", "claude_session"):
        print(f"  {account} {k:17} {st.get(k)}")
    print(f"  {account} {identity_line(account)}")
    print(f"  {account} {'slots':17} {len(st['slots'])}: " + ", ".join(f"{n}={d[:8]}" for n, d in st["slots"].items()))
    if st["ready"]:
        if st["identity"]["exists"] and not st["claude_session"]:
            print(f"  note: the golden identity has no claude.ai session; clones will not be signed in "
                  f"(claude-browser template identity login {account})")
        elif st["claude_session"] is None:
            print(f"  note: no main-Chrome profile is mapped to {account} (config `accounts`); "
                  f"clones will not be signed in to claude.ai")
        elif st["claude_session"] is False:
            print(f"  note: {main_chrome_profile_for(account)} in main Chrome has no claude.ai session; "
                  f"the clone will not be signed in until you sign in there")
        print(f"READY: {account} can be cloned (base + overlay)")
        return 0
    why = base_not_ready_reasons(bs)
    if not st["device_id"]:
        why.append(f"no pairing overlay for {account} (claude-browser template pair {account})")
    die("NOT READY: " + "; ".join(why), 2)


def quit_instance(user_data_dir, timeout=15):
    if not chrome_pids(user_data_dir):
        return True
    kill_instance(user_data_dir)
    for _ in range(timeout * 2):
        if not chrome_pids(user_data_dir) and not is_open(user_data_dir):
            return True
        time.sleep(0.5)
    return not chrome_pids(user_data_dir)


def cmd_template_list():
    bs = base_status()
    if not bs.get("exists"):
        print("no base template (claude-browser template init)")
        return 0
    sc = bs.get("stray_cookies") or {}
    print(f"base       ext={bs.get('claude_extension')} open={bs.get('open')} extensions={bs.get('extension_count')} "
          f"stray_pairing={bs.get('stray_pairing')} stray_cookies={sc.get('claude_rows')}/{sc.get('session_key_rows')}"
          f"  {BASE}")
    for r in base_not_ready_reasons(bs):
        print(f"  NOT READY: {r}")
    for a in known_accounts():
        st = template_status(a)
        slots = ",".join(f"{n}={d[:8]}" for n, d in st["slots"].items()) or "-"
        print(f"{a:10} ready={st.get('ready')}  slots={len(st['slots'])} [{slots}]  "
              f"main_profile={main_chrome_profile_for(a)} session={st.get('main_session')}")
        print(f"{'':10} {identity_line(a)}")
    return 0


def save_overlay(account, src_store, how, slot=1):
    dst = slot_store(account, slot)
    if os.path.isdir(dst):
        shutil.rmtree(dst)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copytree(src_store, dst)
    dev = device_id_in_store(dst)
    write_json(slot_meta_path(account, slot), {
        "account": account, "slot": slot, "device_id": dev, "paired": how,
        "created": time.strftime("%Y-%m-%d %H:%M:%S")})
    return dev


def cmd_template_pair(account, wait=600, slots=None):
    """(Re)pair an account: a base clone WITHOUT pairing, signed in to claude.ai
    from the account's golden identity (else its main-Chrome profile). The human clicks the Claude
    extension once; the resulting local storage (device id + auth hand-off) is
    saved as the account's pairing (slot 1, overwritten if it exists)."""
    bs = base_status()
    if not bs.get("ready"):
        die("base not ready: " + "; ".join(base_not_ready_reasons(bs)), 2)
    ist = identity_status(account)
    if ist["exists"]:
        # The golden identity signs the pairing window in; no main-Chrome profile needed.
        if not ist["session"]:
            die(f"the golden identity of {account} has no claude.ai session: "
                f"claude-browser template identity login {account}", 2)
    else:
        src = main_chrome_profile_for(account)
        if not src:
            die(f"no golden identity and no main-Chrome profile for {account}: "
                f"claude-browser template identity login {account} (or map a profile in config `accounts` "
                f"and run template identity seed {account})", 2)
        if main_profile_has_session(account) is not True:
            die(f"{src} in main Chrome has no claude.ai session for {account}; sign in to claude.ai there, "
                f"or claude-browser template identity login {account}", 2)
    have = account_slots(account)
    if slots:
        missing = [n for n in range(1, int(slots) + 1) if n not in have]
    else:
        missing = [1]           # re-pair (overwrite) the pairing `up` uses
    if not missing:
        print(f"{account} already has {len(have)} slot(s)")
        return 0
    windows = {}
    for n in missing:
        session = f"pair-{account.lower()}-{n}"
        dst = sdir(session)
        if os.path.isdir(dst) and chrome_pids(dst):
            print(f"  slot {n}: pairing window still open, waiting for the click again")
            log_event("pair-resume", session=session, account=account, slot=n)
        else:
            with slot_lock():           # never clone a base that is being swapped
                if os.path.isdir(dst):
                    teardown(session, by="pair-restart")
                dst = clone_template(account, session, slot=None)
                reset_device_id(dst)
            print(f"  slot {n} identity: {refresh_claude_identity(dst, account)}")
            set_profile_name(dst, f"{account} · pair slot {n}")
            identity = caller_identity()
            app = build_instance_app(dst, account, f"pair{n}", identity, session)
            meta = {"session": session, "account": account, "app": app, "purpose": f"pair{n}", "sites": [],
                    "identity": identity, "name": f"{account} · pair slot {n}", "pairing_slot": n,
                    "created": time.strftime("%Y-%m-%d %H:%M:%S")}
            write_json(os.path.join(dst, "instance.json"), meta)
            card = write_instance_card(dst, meta)
            clean_start(dst)
            launch(dst, ["file://" + card, "https://claude.ai/"], account=account, app=app)
            log_event("pair-start", session=session, account=account, slot=n)
        windows[n] = (session, dst)
    print(f"""
HUMAN STEP ({account}): {len(windows)} window(s) titled "{account} · pair slot N" (icon badge
{account_badge(account)}). In EACH one, click the Claude extension icon in the toolbar and authorize it
for {account}. Waiting up to {wait}s…""")
    t0 = time.time()
    rc = 0
    pending = dict(windows)
    while pending and time.time() - t0 < wait:
        for n, (session, dst) in list(pending.items()):
            if device_id(dst):
                time.sleep(5)   # let the extension flush its storage
                quit_instance(dst)
                saved = save_overlay(account, ext_settings(dst), slot=n,
                                     how=f"human click {time.strftime('%Y-%m-%d %H:%M')}")
                teardown(session, by="pair-done")
                log_event("paired", session=session, account=account, slot=n, device_id=saved,
                          waited_s=round(time.time() - t0))
                print(f"PAIRED {account} slot {n}: device id {saved} ({round(time.time() - t0)}s)")
                del pending[n]
        time.sleep(2)
    for n, (session, dst) in pending.items():
        log_event("pair-timeout", session=session, account=account, slot=n, waited_s=round(time.time() - t0))
        print(f"  slot {n}: no device id after {wait}s — window left open: claude-browser down {session}")
        rc = 3
    return rc


# --------------------------------------------------------------- instances

def ensure_native_hosts(user_data_dir):
    """Chrome resolves user-level native messaging host manifests under the
    USER DATA DIR, so a --user-data-dir instance cannot see the main Chrome's
    NativeMessagingHosts directory. A symlink exposes it and stays current as
    hosts are added. (Copies launched from a relocated app bundle still do not
    find them; see README "Known limits".)"""
    link = os.path.join(user_data_dir, "NativeMessagingHosts")
    if not os.path.lexists(link) and os.path.isdir(NMH_MAIN):
        os.symlink(NMH_MAIN, link)


def clone_template(account, session, slot=None):
    """Instance = APFS clone of the shared base + one of this account's pairing
    slots (slot=None: no pairing, for `template pair`)."""
    src, dst = BASE, sdir(session)
    if not os.path.isdir(os.path.join(src, "Default")):
        die("no base template (claude-browser template init)", 2)
    ensure_native_hosts(src)
    if os.path.exists(dst):
        die(f"instance already exists for session {session}: {dst}\n(run  claude-browser down {session}  first)")
    os.makedirs(SESSIONS, exist_ok=True)
    clone_base(dst)
    if slot is not None:
        store = slot_store(account, slot)
        if not os.path.isdir(store):
            die(f"no pairing slot {slot} for {account} (claude-browser template pair {account})", 2)
        reset_device_id(dst)
        shutil.copytree(store, ext_settings(dst))
    return dst


def clone_base(dst, src=None):
    """APFS clonefile of the base (instant, copy-on-write), minus Chrome's
    lock and running-state markers."""
    src = src or BASE
    r = subprocess.run(["cp", "-Rc", src, dst], capture_output=True, text=True)
    if r.returncode != 0:
        shutil.copytree(src, dst, symlinks=True)
    for junk in ("SingletonLock", "SingletonSocket", "SingletonCookie", "lockfile"):
        p = os.path.join(dst, junk)
        if os.path.lexists(p):
            os.unlink(p)


def reset_device_id(user_data_dir):
    """Drop the Claude extension's LevelDB so it mints a fresh bridgeDeviceId."""
    store = ext_settings(user_data_dir)
    if os.path.isdir(store):
        shutil.rmtree(store)


def graft(user_data_dir, sites, dry_run=False):
    """Copy cookies for SITES only (host glob *site per site) from the
    site-cookie source profile. The agent declares the sites it needs;
    nothing else leaves that profile."""
    if not grafter_ok():
        print(f"  graft: SKIPPED — chrome-cookie-graft not found ({GRAFTER})")
        return False
    if not sites:
        print("  graft: SKIPPED — no sites declared")
        return False
    target = os.path.join(user_data_dir, "Default")
    state = os.path.join(user_data_dir, "graft-state.json")
    cmd = [GRAFTER, "--force", "--chrome-dir", MAIN_CHROME, "--source", SITE_COOKIE_SOURCE, "--state", state]
    for site in sites:
        # dotted host: itself + subdomains; single-label host: exactly itself
        cmd += ["--only", site] + (["--only", f"*.{site}"] if "." in site else ["--only", f".{site}"])
    cmd.append(target)
    if dry_run:
        cmd.insert(1, "-n")
    r = subprocess.run(cmd, capture_output=True, text=True)
    for line in (r.stdout + r.stderr).strip().splitlines():
        print("  graft:", line)
    return r.returncode == 0


PURPOSE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,23}$")
HOST_RE = re.compile(r"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
# Single-label names (MagicDNS / LAN hosts such as `nas`) are grafted as that
# exact host only, never `*.<name>`, so even a mistaken `com` could not pull a
# whole domain's cookies. Common top-level domains are still refused for clarity.
LABEL_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")
COMMON_TLDS = {"com", "net", "org", "edu", "gov", "mil", "int", "io", "ai", "co", "app", "dev", "uk", "us",
               "de", "fr", "jp", "cn", "au", "ca", "eu", "info", "biz", "me", "tv", "xyz", "online", "site"}
# Two-label hosts that are public suffixes, not sites: grafting them would copy
# every site under them. Not exhaustive; `allowed_sites` is the real fence.
PUBLIC_SUFFIXES = {"co.uk", "org.uk", "ac.uk", "gov.uk", "com.au", "net.au", "org.au", "co.jp",
                   "co.nz", "co.in", "com.br", "com.cn", "com.mx", "co.za", "github.io", "herokuapp.com",
                   "appspot.com", "blogspot.com", "cloudfront.net", "s3.amazonaws.com"}


def _under(host, base):
    return host == base or host.endswith("." + base)


def check_sites(sites):
    """A site is a dotted hostname (no globs); it covers itself and its
    subdomains. Config `denied_sites` always wins; with `allowed_sites` set,
    every site must fall under one of them."""
    for h in sites:
        single = bool(LABEL_RE.fullmatch(h)) and h not in COMMON_TLDS
        if not (HOST_RE.fullmatch(h) or single) or h in PUBLIC_SUFFIXES:
            return (f"--sites {h!r} is not a hostname like example.com or a single host name like nas "
                    f"(no wildcards, no bare suffixes)")
        if any(_under(h, c.lstrip("*.")) for c in CLAUDE_HOSTS + ["anthropic.com"]):
            return (f"--sites {h!r} is a Claude/Anthropic host: the Claude identity comes only from "
                    f"the account's own profile, and anthropic.com is never grafted")
        if any(_under(h, d) for d in DENIED_SITES):
            return f"--sites {h!r} is denied by config `denied_sites`"
        if ALLOWED_SITES and not any(_under(h, a) for a in ALLOWED_SITES):
            return f"--sites {h!r} is not in config `allowed_sites`"
    return None


def clean_start(user_data_dir):
    """No inherited session in a clone (the base's last tabs), and a clean
    exit flag. NOTE: pinned_tabs / session.restore_on_startup / startup_urls
    are TRACKED prefs (settings-reset HMAC); Chrome discards outside writes
    to them, and --pinned-tab-count did not pin either. Pinning is a
    human-only action; the card tab is marked by its robot favicon and
    "🤖 <badge> <purpose>" title and opens first instead."""
    pref = os.path.join(user_data_dir, "Default", "Preferences")
    p = read_json(pref, {}) or {}
    p.setdefault("profile", {})["exit_type"] = "Normal"
    p["profile"]["exited_cleanly"] = True
    write_json(pref, p)
    for d in ("Sessions", "Session Storage"):
        shutil.rmtree(os.path.join(user_data_dir, "Default", d), ignore_errors=True)


def write_instance_card(user_data_dir, meta):
    """A local page opened as the instance's first tab: who drives this
    browser, from where, and what it is for. Everything in it is also in
    instance.json / `claude-browser list`."""
    ident = meta.get("identity", {})
    sid = meta["session"]
    sites = ", ".join(meta.get("sites") or []) or "none (no graft)"
    badge = account_badge(meta["account"])
    if meta.get("attached") is not None:
        return write_shared_card(user_data_dir, meta, badge, sites)
    rows = [
        ("purpose", meta["purpose"]),
        ("Claude account", f"{meta['account']} (icon badge {badge})"),
        ("Claude session", sid),
        ("resume", f"claude --resume {sid}"),
        ("where it runs", f"{ident.get('kind')} on {ident.get('host')} — {ident.get('pane') or '?'}"
                          f", tab {ident.get('tab') or '?'}, workspace {ident.get('workspace') or '?'}"),
        ("watch it", ident.get("target") or "n/a"),
        ("dock app", os.path.basename(meta.get("app") or "") or "per-account copy"),
        ("sites grafted", sites),
        ("created", meta["created"]),
        ("tear down", f"claude-browser down {sid}"),
    ]
    esc = lambda t: str(t).replace("&", "&amp;").replace("<", "&lt;")
    trs = "".join(f"<tr><th>{esc(k)}</th><td>{esc(v)}</td></tr>" for k, v in rows)
    favicon = ("data:image/svg+xml," + "%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E"
               "%3Crect x='8' y='18' width='48' height='36' rx='8' fill='%231a73e8'/%3E"
               "%3Crect x='18' y='30' width='10' height='10' rx='2' fill='white'/%3E"
               "%3Crect x='36' y='30' width='10' height='10' rx='2' fill='white'/%3E"
               "%3Crect x='24' y='46' width='16' height='4' rx='2' fill='white'/%3E"
               "%3Crect x='30' y='6' width='4' height='12' fill='%231a73e8'/%3E"
               "%3Ccircle cx='32' cy='6' r='4' fill='%231a73e8'/%3E%3C/svg%3E")
    tab_title = f"🤖 {badge} {meta['purpose']}"   # pinning from outside is not possible (see clean_start)
    html = f"""<!doctype html><meta charset=utf-8><title>{esc(tab_title)}</title>
<link rel="icon" href="{favicon}">
<style>body{{font:15px -apple-system,sans-serif;margin:40px;color:#222}}h1{{font-size:28px;margin:0 0 4px}}
.sub{{color:#666;margin-bottom:24px}}table{{border-collapse:collapse}}th{{text-align:left;padding:6px 18px 6px 0;color:#555;white-space:nowrap}}
td{{padding:6px 0;font-family:ui-monospace,Menlo,monospace}}.p{{display:inline-block;background:#1a73e8;color:#fff;border-radius:6px;padding:2px 10px}}</style>
<h1><span class=p>{esc(meta['purpose'])}</span> {esc(meta['account'])}</h1>
<div class=sub>Per-session browser for Claude session {esc(sid[:8])}. Not your everyday Chrome profile. It is deleted when the session ends.</div>
<table>{trs}</table>"""
    path = os.path.join(user_data_dir, "instance-card.html")
    with open(path, "w") as fh:
        fh.write(html)
    return path


def write_shared_card(user_data_dir, meta, badge, sites):
    """The card of an account's shared browser: which agents use it, each
    with its purpose, origin pane and resume command. Rewritten on every
    attach / detach (reload the tab to see the latest)."""
    esc = lambda t: str(t).replace("&", "&amp;").replace("<", "&lt;")
    agents = meta.get("attached") or []
    trs = "".join(
        f"<tr><td>{esc(a.get('purpose'))}</td><td>{esc((a.get('session') or '')[:8])}</td>"
        f"<td>{esc((a.get('identity') or {}).get('kind'))}:{esc((a.get('identity') or {}).get('pane') or '?')}</td>"
        f"<td>{esc(', '.join(a.get('sites') or []) or '-')}</td><td>claude --resume {esc(a.get('session'))}</td></tr>"
        for a in agents) or "<tr><td colspan=5>no agent attached</td></tr>"
    html = f"""<!doctype html><meta charset=utf-8><title>🤖 {esc(badge)} agents ({len(agents)})</title>
<style>body{{font:15px -apple-system,sans-serif;margin:40px;color:#222}}h1{{font-size:28px;margin:0 0 4px}}
.sub{{color:#666;margin-bottom:24px}}table{{border-collapse:collapse}}th,td{{text-align:left;padding:6px 18px 6px 0}}
td{{font-family:ui-monospace,Menlo,monospace}}th{{color:#555}}</style>
<h1>{esc(meta['account'])} — shared agent browser</h1>
<div class=sub>One Chrome per Claude account; each agent works in its own tab group. Not your everyday Chrome
profile. It is deleted when the last agent detaches. Sites grafted at launch: {esc(sites)}. Updated {esc(time.strftime('%H:%M:%S'))}.</div>
<table><tr><th>purpose</th><th>session</th><th>from</th><th>sites asked</th><th>resume</th></tr>{trs}</table>"""
    path = os.path.join(user_data_dir, "instance-card.html")
    with open(path, "w") as fh:
        fh.write(html)
    return path


def _graft_claude(chrome_dir, source, user_data_dir):
    """Copy ONLY the claude.* identity cookies from profile SOURCE of the Chrome
    user-data-dir CHROME_DIR into USER_DATA_DIR's Default profile, overwriting
    what is there. Returns (ok, the grafter's last line)."""
    cfg = {"source": source, "targets": [os.path.join(user_data_dir, "Default")],
           "only": CLAUDE_HOSTS, "protect": ["chrome-extension://*"], "exclude": [],
           "stale_days": 365, "keep_backups": 1, "min_interval_minutes": 0}
    cfg_path = os.path.join(user_data_dir, "identity-graft-config.json")
    write_json(cfg_path, cfg)
    r = subprocess.run([GRAFTER, "-c", cfg_path, "--chrome-dir", chrome_dir, "--force", "--replace-all",
                        "--state", os.path.join(user_data_dir, "identity-state.json")],
                       capture_output=True, text=True)
    last = (r.stdout + r.stderr).strip().splitlines()[-1:] or ["?"]
    return r.returncode == 0, last[0].strip()


def refresh_claude_identity(user_data_dir, account):
    """At every launch, re-copy ONLY the claude.* identity cookies into the
    clone. Source: the account's golden identity (templates/<account>/identity/)
    when it exists; only when there is none, the account's profile in the main
    Chrome. Skipped when the source has no sessionKey."""
    ist = identity_status(account)
    if ist["exists"]:
        if not ist["session"]:
            return (f"golden identity has no live claude.ai session; clone keeps none ({base_clean_note()}) "
                    f"(claude-browser template identity login {account})")
        if not grafter_ok():
            return "grafter missing"
        # Reading a copy of the DB is safe while a refresh has it open (the
        # grafter snapshots its source, as it does from the always-open main Chrome).
        ok, last = _graft_claude(ist["dir"], "Default", user_data_dir)
        how = f"from golden identity (sessionKey expires {(ist.get('expires') or '?')[:10]})"
        return f"{how}: {last}" if ok else f"FAILED {how}: {last}"
    src, src_db = main_profile_cookies(account)
    if not src:
        return ("no golden identity and no main-Chrome profile mapped to this account; clone keeps none "
                f"({base_clean_note()}) (claude-browser template identity login {account})")
    how = f"from main-Chrome profile {src} (no golden identity: claude-browser template identity seed {account})"
    if not src_db or not _db_has_claude_session(src_db):
        return f"{src} has no live claude.ai session; clone keeps none ({base_clean_note()})"
    if not grafter_ok():
        return "grafter missing"
    ok, last = _graft_claude(MAIN_CHROME, src, user_data_dir)
    return f"{how}: {last}" if ok else f"FAILED {how}: {last}"


# ---------------------------------------------------------- golden identity
#
# templates/<account>/identity/ is a user-data-dir that holds the account's
# claude.ai login. It is created FRESH (an empty dir Chrome builds its own
# skeleton in), never cloned from the base, so it inherits nothing; the login is
# then grafted in (seed) or typed in by a human (login). It is a full Chrome
# profile: a human sign-in there (Google SSO, say) or a refresh can leave other
# sites' cookies in it. Those never reach agent browsers: the graft out of it
# copies CLAUDE_HOSTS only. It is never paired, attached or listed as a browser,
# and runs only briefly: hidden, to let claude.ai load (`template identity
# refresh`, and `gc` once a day), or visibly for a human sign-in (`template
# identity login`). It always runs with --disable-extensions.

def identity_dir(account):
    # Lowercase, like sessions/acct-<account>: the --user-data-dir text must not
    # depend on how a caller spelled the account (APFS ignores case, `ps` does not).
    parent = os.path.join(TEMPLATES, check_name("account", account).lower())
    d = os.path.join(parent, "identity")
    if os.path.lexists(d) and not inside(d, parent):
        die(f"refusing {d}: it resolves outside {parent}")
    return d


def identity_meta_path(account):
    return os.path.join(identity_dir(account), "identity.json")


CHROME_EPOCH_OFFSET = 11644473600     # seconds from 1601-01-01 (Chrome's epoch) to 1970-01-01
CLAUDE_SESSION_HOSTS = {"claude.ai", ".claude.ai"}   # where claude.ai keeps sessionKey


def chrome_time_str(expires_utc):
    """Chrome's expires_utc (µs since 1601) as local time; 0 = a session cookie."""
    if expires_utc is None:
        return None
    if not expires_utc:
        return "session-only"
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(expires_utc / 1e6 - CHROME_EPOCH_OFFSET))


def chrome_now():
    return int((time.time() + CHROME_EPOCH_OFFSET) * 1e6)


def _cookie_meta_rows(db):
    """(host_key, name, expires_utc) of every row, from a copy of a Cookies DB
    (the live one may be locked). Values are never selected or decrypted.
    None if unreadable."""
    if not db:
        return None
    fd, tmp = tempfile.mkstemp(suffix=".sqlite")
    os.close(fd)
    try:
        shutil.copy(db, tmp)
        c = sqlite3.connect(tmp)
        rows = c.execute("select host_key, name, expires_utc from cookies").fetchall()
        c.close()
        return rows
    except Exception:
        return None
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass


def _db_session_expiry(db):
    """(a live claude.ai sessionKey is present, the newest such row's expires_utc).
    Live = host exactly claude.ai / .claude.ai and not yet expired. An expired
    row still reports its expiry (so `template list` can show when it lapsed)."""
    rows = [(h, e) for (h, n, e) in (_cookie_meta_rows(db) or [])
            if n == "sessionKey" and (h or "").lower() in CLAUDE_SESSION_HOSTS]
    if not rows:
        return False, None
    now = chrome_now()
    return any((e or 0) > now for _, e in rows), max(e or 0 for _, e in rows)


def _host_matches(host, patterns):
    """chrome-cookie-graft's glob rule: '*.example.com' also matches
    '.example.com', which is how Chrome spells a domain cookie."""
    import fnmatch
    h = (host or "").lower()
    for p in (x.lower() for x in patterns):
        if fnmatch.fnmatch(h, p) or (p.startswith("*.") and h == p[1:]):
            return True
    return False


# What may sit in the base. A fresh install leaves Web Store / Google consent
# and captcha cookies, and the Claude extension may open a claude.ai page
# (anonymous rows). LOGIN cookies are what must never be there: every clone
# and every pairing window starts with the base's cookies.
CLAUDE_LOGIN_NAMES = {"sessionKey", "sessionKeyV3", "lastActiveOrg", "routingHint"}
GOOGLE_LOGIN_NAMES = {"SID", "HSID", "SSID", "APISID", "SAPISID", "LSID", "__Secure-1PSID",
                      "__Secure-3PSID", "__Host-GAPS", "__Secure-1PAPISID", "__Secure-3PAPISID"}
BASE_ALLOWED_SUFFIXES = ("google.com", "gstatic.com", "googleusercontent.com", "hcaptcha.com")


def _host_under(h, suffix):
    h = h.lstrip(".")
    return h == suffix or h.endswith("." + suffix)


def cookie_census(user_data_dir):
    """Counts and host names only (host_key / name, never values): claude-host
    rows, Claude login rows, Google login rows, and hosts outside what a base
    may hold. None if there is no readable Cookies DB."""
    rows = _cookie_meta_rows(cookies_db(user_data_dir))
    if rows is None:
        return None
    claude = [r for r in rows if _host_matches(r[0], CLAUDE_HOSTS)]
    google = [r for r in rows if _host_under(r[0], "google.com")]
    foreign = sorted({h for (h, _, _) in rows if not _host_matches(h, CLAUDE_HOSTS)
                      and not any(_host_under(h, sfx) for sfx in BASE_ALLOWED_SUFFIXES)})
    return {"claude_rows": len(claude),
            "session_key_rows": sum(1 for (_, n, _) in claude if n in CLAUDE_LOGIN_NAMES),
            "google_login_rows": sum(1 for (_, n, _) in google if n in GOOGLE_LOGIN_NAMES),
            "foreign_hosts": foreign,
            "rows": len(rows)}


def base_cookie_problems(c, cookies_file_exists):
    """Why a base's cookie jar is not acceptable (empty list = clean)."""
    if c is None:
        return ["its Cookies database could not be read"] if cookies_file_exists else []
    out = []
    if c["session_key_rows"]:
        out.append(f"{c['session_key_rows']} claude.ai login cookie(s)")
    if c["google_login_rows"]:
        out.append(f"{c['google_login_rows']} Google sign-in cookie(s)")
    if c["foreign_hosts"]:
        out.append("cookies for " + ", ".join(c["foreign_hosts"][:8]) + ("…" if len(c["foreign_hosts"]) > 8 else ""))
    return out


def _claude_rows(user_data_dir):
    c = cookie_census(user_data_dir)
    return c and c["claude_rows"]


def identity_open(d):
    return bool(chrome_pids(d)) or is_open(d)


def identity_status(account):
    d = identity_dir(account)
    meta = read_json(os.path.join(d, "identity.json"), {}) or {}
    st = {"dir": d, "exists": bool(cookies_db(d)), "session": False,
          "expires_utc": None, "expires": None, "refreshed_at": meta.get("refreshed_at"),
          "seeded_at": meta.get("seeded_at"), "source": meta.get("source"), "open": False}
    if st["exists"]:
        st["session"], st["expires_utc"] = _db_session_expiry(cookies_db(d))
        st["expires"] = chrome_time_str(st["expires_utc"])
        st["open"] = identity_open(d)
    # Hours since the last refresh, else since the seed or login; None = never.
    last = meta.get("refreshed_ts") or meta.get("seeded_ts")
    st["age_s"] = (time.time() - last) if last else None
    st["age_hours"] = round(st["age_s"] / 3600, 3) if last else None
    return st


def identity_line(account):
    st = identity_status(account)
    if not st["exists"]:
        return f"identity: none (claude-browser template identity seed|login {account})"
    return (f"identity: session={st['session']} expires={(st['expires'] or '-')[:10]} "
            f"refreshed={st['refreshed_at'] or 'never'} source={st['source'] or '?'}"
            + (" OPEN" if st["open"] else ""))


def _update_identity_meta(account, **fields):
    """Merge FIELDS into identity.json (None removes a key). Caller holds slot_lock."""
    path = identity_meta_path(account)
    meta = read_json(path, {}) or {}
    for k, v in fields.items():
        if v is None:
            meta.pop(k, None)
        else:
            meta[k] = v
    write_json(path, meta)
    return meta


# Who started the identity's Chrome, recorded under the lock BEFORE it is
# launched, so gc can quit an identity Chrome whose starter died (a gc killed
# mid-wait, a launch that came up after its timeout, a Ctrl-C'd login).
ORPHAN_MARGIN_S = 60


def _mark_identity_chrome(account, purpose):
    _update_identity_meta(account, chrome_owner_pid=os.getpid(), chrome_started_ts=time.time(),
                          chrome_purpose=purpose)


def _unmark_identity_chrome(account):
    _update_identity_meta(account, chrome_owner_pid=None, chrome_started_ts=None, chrome_purpose=None)


def _owner_running(pid):
    """A live claude-browser process (not just any process that reused the pid)."""
    try:
        os.kill(int(pid), 0)
    except (OSError, ValueError, TypeError):
        return False
    cmd = subprocess.run(["ps", "-o", "command=", "-p", str(int(pid))], capture_output=True, text=True).stdout
    return "claude-browser" in cmd


def quit_identity(d):
    """Quit the identity's Chrome (SIGTERM, then SIGKILL) and wait until the
    Cookies DB is closed. Returns True if it went on SIGTERM."""
    clean = quit_instance(d)
    if not clean:
        kill_instance(d, 9)
    for _ in range(40):
        if not chrome_pids(d) and not is_open(d):
            break
        time.sleep(0.5)
    return clean


def launch_identity(d, url, hidden):
    """Stock Chrome (not the Dock-app copies), extensions off. hidden: `open -g -j`.
    The caller has marked the identity's Chrome (_mark_identity_chrome)."""
    reset_device_id(d)
    clean_start(d)
    subprocess.run(["open"] + (["-g", "-j"] if hidden else []) + ["-na", CHROME_APP_SRC, "--args",
                    f"--user-data-dir={d}", "--profile-directory=Default",
                    "--no-first-run", "--no-default-browser-check", "--disable-extensions",
                    "--disable-session-crashed-bubble", "--hide-crash-restore-bubble", url], check=False)
    for _ in range(30):
        if chrome_pids(d):
            return True
        time.sleep(0.5)
    # Timed out. A last look, and whatever came up late is quit: this caller is
    # giving up on it. (One that starts later still is gc's: the mark stays.)
    time.sleep(2)
    if chrome_pids(d):
        quit_identity(d)
    return False


def ensure_identity(account):
    """Create templates/<account>/identity/ if missing, FRESH: an empty dir that
    Chrome builds its own profile skeleton in (hidden, extensions off, about:blank).
    Nothing is cloned, so nothing is inherited. Returns (dir, created).
    Caller holds slot_lock."""
    d = identity_dir(account)
    if cookies_db(d):
        return d, False
    if os.path.lexists(d):
        # A creation that died before Chrome wrote its Cookies DB leaves identity.json.
        if os.path.isdir(d) and not os.path.islink(d) and os.path.exists(os.path.join(d, "identity.json")) \
                and not chrome_pids(d):
            shutil.rmtree(d)
        else:
            die(f"{d} exists but is not a claude-browser identity; move it aside first")
    os.makedirs(os.path.join(d, "Default"))
    os.chmod(d, 0o700)                          # user-only, like the Cookies file Chrome writes in it
    set_profile_name(d, f"{account} · claude.ai identity")
    _mark_identity_chrome(account, "create")
    if not launch_identity(d, "about:blank", hidden=True):
        die(f"Chrome did not start on {d}", 3)
    for _ in range(40):
        if cookies_db(d):
            break
        time.sleep(0.5)
    time.sleep(1)
    quit_identity(d)
    _unmark_identity_chrome(account)
    census = cookie_census(d)
    if census is None:
        die(f"Chrome created no Cookies DB in {d}; run this again", 3)
    log_event("identity-create", account=account, cookie_rows=census["rows"],
              claude_rows=census["claude_rows"])
    return d, True


def identity_record(account, **fields):
    """Rewrite identity.json from what the closed profile holds now."""
    has, exp = _db_session_expiry(cookies_db(identity_dir(account)))
    return _update_identity_meta(account, **fields, session_present=has, expires_utc=exp,
                                 expires=chrome_time_str(exp))


def agent_browser_launching(account):
    """`up` has claimed the account's browser dir but not launched it yet: the
    window in which it grafts the claude.ai identity. Caller holds slot_lock."""
    m = next((x for x in instances() if x["session"] == instance_name(account)), None)
    return bool(m and not m["running"] and not m.get("pid") and (m.get("age_hours") or 0) < SETTLE_HOURS)


def identity_refresh_begin(account):
    """Decide and launch, under slot_lock (the caller holds it): skip when the
    identity is open or the account's agent browser is mid-launch; otherwise
    start the hidden Chrome before the lock is released, so the next locker
    sees it open. Returns (before-status, None) or (None, reason)."""
    st = identity_status(account)
    if not st["exists"]:
        return None, f"no golden identity (claude-browser template identity seed|login {account})"
    if st["open"]:
        return None, "open in Chrome"
    if agent_browser_launching(account):
        return None, "its agent browser is being launched"
    if not st["session"]:
        log_event("identity-stale", account=account, phase="before-refresh")
        return None, f"no live claude.ai sessionKey (claude-browser template identity login {account})"
    st["claude_rows"] = _claude_rows(st["dir"])
    _mark_identity_chrome(account, "refresh")
    if not launch_identity(st["dir"], "https://claude.ai/", hidden=True):
        return None, "Chrome did not start"
    st["t0"] = time.time()
    return st, None


def identity_refresh_finish(account, before, seconds):
    """Outside the lock: let claude.ai load for SECONDS, quit, record.
    Whether loading claude.ai moves the sessionKey's expiry is NOT assumed:
    the event records the expiry before and after."""
    d = before["dir"]
    while time.time() - before["t0"] < seconds and chrome_pids(d):
        time.sleep(1)
    exited_early = not chrome_pids(d)
    quit_ok = quit_identity(d)
    with slot_lock():
        now = time.time()
        meta = identity_record(account, refreshed_at=time.strftime("%Y-%m-%d %H:%M:%S"), refreshed_ts=now,
                               chrome_owner_pid=None, chrome_started_ts=None, chrome_purpose=None)
    b, a = before.get("expires_utc"), meta.get("expires_utc")
    moved = None if (b is None or a is None) else round((a - b) / 1e6 / 3600, 2)
    log_event("identity-refresh", account=account, before=chrome_time_str(b), after=meta.get("expires"),
              moved_hours=moved, waited_s=round(now - before["t0"]), exited_early=exited_early,
              quit_clean=quit_ok, claude_rows_before=before.get("claude_rows"),
              claude_rows_after=_claude_rows(d))
    if not meta.get("session_present"):
        log_event("identity-stale", account=account, phase="after-refresh")
    meta["moved_hours"] = moved
    meta["before"] = chrome_time_str(b)
    return meta


def refresh_summary(meta):
    if not meta.get("session_present"):
        return f"NO live sessionKey after the refresh (was {meta.get('before')}): sign in again with template identity login"
    mv = meta.get("moved_hours")
    how = "unchanged" if mv == 0 else (f"moved {mv:+} h" if mv is not None else "?")
    return f"sessionKey expiry {meta.get('before')} → {meta.get('expires')} ({how})"


def identity_accounts(which, all_, need_main=False, need_identity=False):
    if all_:
        out = known_accounts()
        if need_main:
            out = [a for a in out if main_chrome_profile_for(a)]
        if need_identity:
            out = [a for a in out if identity_status(a)["exists"]]
        return out
    if not which:
        die("name an account or pass --all")
    return [check_name("account", which)]


def cmd_identity_seed(account, all_):
    """One-time migration: graft the account's claude.* cookies from its
    main-Chrome profile into its golden identity (created fresh if missing)."""
    rc = 0
    if not grafter_ok():
        die(f"chrome-cookie-graft not found ({GRAFTER})")
    for a in identity_accounts(account, all_, need_main=True):
        src, src_db = main_profile_cookies(a)
        if not src:
            print(f"identity {a}: SKIPPED — no main-Chrome profile mapped (config `accounts`); "
                  f"use  claude-browser template identity login {a}")
            rc = 2
            continue
        if not src_db or not _db_has_claude_session(src_db):
            print(f"identity {a}: SKIPPED — {src} in main Chrome has no live claude.ai session; "
                  f"use  claude-browser template identity login {a}")
            rc = 2
            continue
        with slot_lock():
            d, created = ensure_identity(a)
            if identity_open(d):
                print(f"identity {a}: REFUSED — {d} is open in Chrome; quit it (or wait for the refresh) first")
                rc = 1
                continue
            ok, last = _graft_claude(MAIN_CHROME, src, d)
            meta = identity_record(a, seeded_at=time.strftime("%Y-%m-%d %H:%M:%S"), seeded_ts=time.time(),
                                   source=f"main-chrome:{src}")
        log_event("identity-seed", account=a, source=src, ok=ok, created=created,
                  session=meta.get("session_present"), expires=meta.get("expires"))
        print(f"identity {a}: {'seeded' if ok else 'FAILED'} from {src}{' (new identity)' if created else ''}: {last}")
        print(f"  sessionKey present={meta.get('session_present')} expires={meta.get('expires')}  {d}")
        rc = rc or (0 if ok and meta.get("session_present") else 3)
    return rc


def cmd_identity_refresh(account, all_, if_older_than=None):
    rc = 0
    for a in identity_accounts(account, all_, need_identity=True):
        st = identity_status(a)
        if not st["exists"]:
            print(f"identity {a}: SKIPPED — none (claude-browser template identity seed|login {a})")
            rc = 2
            continue
        if if_older_than is not None and st["age_hours"] is not None and st["age_hours"] < if_older_than:
            print(f"identity {a}: fresh ({st['age_hours']} h < {if_older_than} h), not refreshed")
            continue
        with slot_lock():
            before, why = identity_refresh_begin(a)
        if not before:
            print(f"identity {a}: SKIPPED — {why}")
            rc = rc or 1
            continue
        print(f"identity {a}: launched hidden on claude.ai; quitting it in {int(IDENTITY_REFRESH_SECONDS)} s")
        meta = identity_refresh_finish(a, before, IDENTITY_REFRESH_SECONDS)
        print(f"identity {a}: refreshed {meta.get('refreshed_at')}; {refresh_summary(meta)}")
        rc = rc or (0 if meta.get("session_present") else 3)
    return rc


def cmd_identity_login(account, wait=600):
    """Recovery when a golden login lapses: open the identity visibly at
    claude.ai/login; a human signs in; the new sessionKey is recorded."""
    check_name("account", account)
    with slot_lock():
        d, created = ensure_identity(account)
        if identity_open(d):
            die(f"{d} is already open in Chrome; quit it first")
        # A live login that was there before must change to count; an identity
        # this call just created holds none, whatever any check says.
        had, exp0 = (False, None) if created else _db_session_expiry(cookies_db(d))
        _mark_identity_chrome(account, "login")
        if not launch_identity(d, "https://claude.ai/login", hidden=False):
            die("Chrome did not start", 3)
    log_event("identity-login-start", account=account, had_session=had, created=created)
    print(f"""Opened "{account} · claude.ai identity" at claude.ai/login.
HUMAN STEP: sign in to claude.ai as {account} in that window. It closes by itself once the
login is saved (already signed in? quit it with Cmd-Q). Waiting up to {wait}s…""")
    t0 = time.time()
    got = False
    while time.time() - t0 < wait:
        if not chrome_pids(d):
            break                                   # the human quit it
        if (_db_has_claude_session(cookies_db(d)) if not had
                else _db_session_expiry(cookies_db(d))[1] not in (None, exp0)):
            got = True
            time.sleep(5)                           # let Chrome flush the rest of the login
            break
        time.sleep(2)
    quit_identity(d)
    with slot_lock():
        now = {"refreshed_at": time.strftime("%Y-%m-%d %H:%M:%S"), "refreshed_ts": time.time()}
        if not (read_json(identity_meta_path(account), {}) or {}).get("seeded_at"):
            now.update(seeded_at=now["refreshed_at"], seeded_ts=now["refreshed_ts"])
        meta = identity_record(account, source="login", chrome_owner_pid=None, chrome_started_ts=None,
                               chrome_purpose=None, **now)
    log_event("identity-login", account=account, new_session=got, session=meta.get("session_present"),
              expires=meta.get("expires"), waited_s=round(time.time() - t0))
    if not meta.get("session_present"):
        log_event("identity-stale", account=account, phase="after-login")
        print(f"identity {account}: NO live claude.ai sessionKey saved; run this again")
        return 3
    print(f"identity {account}: sessionKey present, expires {meta.get('expires')}"
          + ("" if got else " (unchanged: no new sign-in seen)"))
    return 0


def reap_identity_orphans():
    """Quit an identity Chrome whose recorded starter is gone and that has been
    open longer than a refresh plus a margin; clear stale marks."""
    n = 0
    for a in known_accounts():
        d = identity_dir(a)
        meta = read_json(os.path.join(d, "identity.json"), {}) or {}
        pid = meta.get("chrome_owner_pid")
        if not pid or _owner_running(pid):
            continue
        age = time.time() - (meta.get("chrome_started_ts") or 0)
        if identity_open(d):
            if age < IDENTITY_REFRESH_SECONDS + ORPHAN_MARGIN_S:
                continue
            clean = quit_identity(d)
            log_event("identity-orphan-quit", account=a, purpose=meta.get("chrome_purpose"),
                      owner_pid=pid, age_s=round(age), quit_clean=clean)
            print(f"gc: identity {a}: quit an orphaned {meta.get('chrome_purpose')} Chrome "
                  f"(starter {pid} gone, open {round(age)} s)")
            n += 1
        with slot_lock():
            _unmark_identity_chrome(a)
    return n


def gc_identity():
    """One golden identity per `gc` run, the longest unrefreshed one that is
    due, so a run stays short. Ordering against `up`: the decision and the
    hidden launch happen under slot_lock, and an account whose agent browser
    is mid-launch (claimed, not yet started: when `up` grafts from the
    identity) is skipped; the identity_refresh_seconds wait and the quit run
    outside the lock, so `up` is never blocked for long. An `up` that runs
    during the wait grafts from a copy of the open identity's DB: whatever
    Chrome has written to disk by then. Orphaned identity Chromes are
    quit first, whatever identity_refresh_hours says."""
    reap_identity_orphans()
    if not IDENTITY_REFRESH_HOURS:
        return 0
    due = []
    for a in known_accounts():
        st = identity_status(a)
        if st["exists"] and st["session"] and (st["age_hours"] is None or st["age_hours"] >= IDENTITY_REFRESH_HOURS):
            due.append((-(st["age_s"] if st["age_s"] is not None else 1e12), a))   # oldest first
    if not due:
        return 0
    before = acct = None
    with slot_lock():
        for _, a in sorted(due):
            before, why = identity_refresh_begin(a)
            if before:
                acct = a
                break
            print(f"gc: identity {a} skipped ({why})")
    if not before:
        return 0
    meta = identity_refresh_finish(acct, before, IDENTITY_REFRESH_SECONDS)
    print(f"gc: identity {acct} refreshed; {refresh_summary(meta)}")
    return 1


RELAY_SECONDS = 240     # a fresh browser registers on the relay within ~1–4 min (observed)


def relay_hint(launched_at):
    """What an agent should do right after `up`: a browser launched moments ago
    is not on the relay yet, and select_browser fails until it is."""
    age = time.time() - launched_at if launched_at else None
    if age is not None and age < RELAY_SECONDS:
        return (f"  This browser was launched {int(age)} s ago and registers on the relay within ~1–4 min.\n"
                f"  Poll list_connected_browsers (every ~15 s, up to {RELAY_SECONDS // 60} min) until the id below is "
                f"listed, THEN select_browser. \"No connected browser has deviceId\" before that means: keep waiting, "
                f"you are not blocked, do not run `down`.")
    return None


def instance_name(account):
    return "acct-" + account.lower()


def find_attached(session):
    for m in instances():
        for a in m.get("attachments") or []:
            if a.get("session") == session:
                return m, a
    return None, None


def cmd_up(args):
    """Attach this session to its account's shared browser, launching it if
    there is none. Idempotent: a session already attached gets its browser
    reported again, before any account detection (detection can drift
    mid-session when the machine's default login is switched)."""
    session = args.session or os.environ.get("CLAUDE_SESSION_ID")
    if not session:
        die("no session id; pass --session or export CLAUDE_SESSION_ID")
    check_name("session", session)
    m, a = find_attached(session)
    if m and (m["running"] or not reap_reason(m)):
        if args.account and args.account.lower() != (m.get("account") or "").lower():
            die(f"this session is already attached to the {m.get('account')} browser; "
                f"`claude-browser down` first to switch to {args.account}")
        # A resumed session (claude --resume) runs in a new process: record it,
        # or the reaper would take the old, dead PID as "agent gone".
        me = owner_pid()
        hold = getattr(args, "hold", None)
        if m.get("attached") is not None and ((me and a.get("owner_pid") != me) or hold):
            with slot_lock():
                def refresh(mt):
                    for x in mt.get("attached", []):
                        if x.get("session") == session:
                            if me:
                                x["owner_pid"] = me
                            if hold:
                                x["hold_until"] = time.time() + min(hold, HOLD_MAX_MINUTES) * 60
                update_meta(m["dir"], refresh)
            if hold:
                print(f"  hold: the idle reaper leaves this browser alone for {min(hold, HOLD_MAX_MINUTES)} min")
        print(f"up: this session is already attached to the {m.get('account')} browser "
              f"(purpose {a.get('purpose')}), device id {m.get('device_id')}")
        print(f"NEXT (in the agent): list_connected_browsers → select_browser deviceId={m.get('device_id')}")
        return 0
    account = args.account or session_account()
    if not account:
        die("cannot determine this session's Claude account: pass --account <name>, export "
            "CLAUDE_BROWSER_ACCOUNT, or set config `account_detector` (see `claude-browser config`)")
    check_name("account", account)
    st = template_status(account)
    if not st.get("ready"):
        why = base_not_ready_reasons(st["base"]) + ([] if st["device_id"] else [f"no pairing for {account}"])
        die(f"template {account} is not ready: {'; '.join(why)} (claude-browser template check {account}).\n"
            f"STOP here and tell the human this message. Do not select another browser instead (in particular "
            f"not the human's own Chrome profile, which carries their live logins).", 2,
            account=account, session=session)
    purpose = (args.purpose or "").strip()
    if not PURPOSE_RE.match(purpose):
        die("refusing to launch: --purpose <one-word> is required (letters, digits, - or _; max 24), "
            "e.g. --purpose bank. It names what this agent uses the browser for, in `list` and on the card.",
            account=account, session=session, purpose=purpose or None)
    sites = [x.strip().lower() for x in (args.sites or "").split(",") if x.strip()]
    bad = check_sites(sites)
    if bad:
        die(f"refusing to launch: {bad}", account=account, session=session, purpose=purpose)
    if not args.no_graft and not sites:
        die("refusing to launch: --sites host[,host...] is required unless --no-graft, "
            "e.g. --sites example.com,example.net. Only cookies for those hosts are copied in.",
            account=account, session=session, purpose=purpose)
    identity = caller_identity(args.origin)
    att = {"session": session, "purpose": purpose, "sites": sites, "identity": identity,
           "owner_pid": owner_pid(), "attached_at": time.strftime("%Y-%m-%d %H:%M:%S")}
    if args.hold:
        att["hold_until"] = time.time() + min(args.hold, HOLD_MAX_MINUTES) * 60
    name = instance_name(account)
    print(f"up: account={account} purpose={purpose} session={session} "
          f"from={identity['kind']}:{identity.get('pane') or '?'} sites={','.join(sites) or '-'}")
    # Under one lock: reap, then either attach to the account's live (or
    # starting) browser, or claim its directory by writing instance.json.
    with slot_lock():
        reap("up-reap")
        live = next((x for x in instances() if x["session"] == name and (x["running"] or not reap_reason(x))), None)
        # A browser started by 0.1.x (one per session, own dir name) holds the
        # account's device id too: adopt it as the shared browser rather than
        # launching a second one with the same id.
        # Only one that carries the account's saved pairing: a 0.1.x browser whose
        # device id was reset never paired and is useless to every agent.
        paired_id = account_slots(account).get(1)
        live = live or next((x for x in instances() if x.get("account") == account and x["running"]
                             and not x["session"].startswith("pair-") and x.get("attached") is None
                             and x.get("device_id") and x.get("device_id") == paired_id), None)
        if live:
            if not (live.get("device_id") or device_id(live["dir"])):
                die(f"the {account} browser is still being set up (no device id yet); run `up` again in a minute",
                    3, account=account, session=session, purpose=purpose)
            def add(mt):
                if mt.get("attached") is None:
                    mt["attached"] = attachments(mt)
                mt["attached"].append(att)
            meta = update_meta(live["dir"], add)
            rewrite_card(live["dir"])
            covered = meta.get("sites") or []
            missing = [h for h in sites if not any((_under(h, c) if "." in c else h == c) for c in covered)]
            dev = live.get("device_id") or device_id(live["dir"])
            log_event("attach", session=session, account=account, purpose=purpose, sites=sites,
                      instance=name, missing_sites=missing, identity=identity)
            print(f"  attached to the {account} browser ({len(meta['attached'])} agent(s)); "
                  f"work in your own tab group and close it when done")
            hint = relay_hint(meta.get("launched_at") or (time.time() if not meta.get("pid") else None))
            if hint:
                print(hint)
            if missing:
                print(f"  NOTE: cookies for {', '.join(missing)} were not grafted (Chrome cannot take new cookies "
                      f"while running). Log in to those sites in this window if needed; the login stays for "
                      f"this browser's lifetime.")
            print(f"  device id {dev}")
            print(f"NEXT (in the agent): list_connected_browsers → select_browser deviceId={dev}")
            return 0
        dst = clone_template(account, name, slot=1)
        write_json(os.path.join(dst, "instance.json"), {"session": name, "account": account, "slot": 1,
                   "purpose": "agents", "sites": sites, "attached": [att],
                   "created": time.strftime("%Y-%m-%d %H:%M:%S")})
    print(f"  cloned  {dst}")
    set_profile_name(dst, f"{account} · agents")
    if not args.no_graft:
        graft(dst, sites)
    ident_note = refresh_claude_identity(dst, account)
    print(f"  identity: {ident_note}")
    app = build_instance_app(dst, account, "agents", {"kind": "custom", "pane": account}, name)
    with slot_lock():
        update_meta(dst, lambda mt: mt.update(app=app, identity=identity, name=f"{account} · agents"))
    print(f"  dock app: {os.path.basename(app) if app else 'per-account copy (instance icon not built)'}")
    rewrite_card(dst)
    clean_start(dst)
    launch(dst, ["file://" + os.path.join(dst, "instance-card.html"), "https://claude.ai/"], account=account, app=app)
    pids = []
    for _ in range(10):
        pids = chrome_pids(dst)
        if pids:
            break
        time.sleep(0.5)
    if not pids:
        die("  Chrome did not start for this instance", 3)
    with slot_lock():
        update_meta(dst, lambda mt: mt.update(pid=min(pids), launched_at=time.time()))
    print(f"  launched pid {min(pids)} window '{account} · agents'")
    t_launch = time.time()
    log_event("up", session=session, account=account, purpose=purpose, sites=sites, instance=name,
              identity=identity, claude_identity=ident_note, graft=not args.no_graft)
    new_id = wait_for_device_id(dst, timeout=args.wait)
    log_event("device-id" if new_id else "no-device-id", session=session, account=account,
              purpose=purpose, device_id=new_id, waited_s=round(time.time() - t_launch))
    with slot_lock():
        update_meta(dst, lambda mt: mt.update(device_id=new_id))
    if not new_id:
        print(f"  WARNING: no bridgeDeviceId after {args.wait}s — the extension may need a human click in this window")
        return 3
    print(f"  device id {new_id}")
    print(relay_hint(t_launch))
    print(f"NEXT (in the agent): list_connected_browsers → select_browser deviceId={new_id}")
    return 0


def instances():
    out = []
    if not os.path.isdir(SESSIONS):
        return out
    for s in sorted(os.listdir(SESSIONS)):
        if not NAME_RE.fullmatch(s) or ".." in s or s != s.lower():
            continue
        d = sdir(s)
        if not os.path.isdir(d):
            continue
        meta = read_json(os.path.join(d, "instance.json"), {}) or {}
        meta["session"] = s       # the directory name, never a value from inside the file
        meta["dir"] = d
        meta["running"] = bool(chrome_pids(d))
        # An instance that was launched (has a pid) but whose Chrome is gone,
        # without a teardown: record it once, so a crash or an outside kill is
        # visible in the event log instead of silent.
        marker = os.path.join(d, "exited.logged")
        if not meta["running"] and meta.get("pid") and not os.path.exists(marker):
            log_event("chrome-exited", session=s, account=meta.get("account"), purpose=meta.get("purpose"),
                      pid=meta.get("pid"))
            try:
                open(marker, "w").close()
            except OSError:
                pass
        meta["device_id"] = device_id(d) or meta.get("device_id")
        meta["owner_alive"] = owner_alive(meta.get("owner_pid"))
        meta["attachments"] = [dict(x, owner_alive=owner_alive(x.get("owner_pid"))) for x in attachments(meta)]
        la = last_activity(d)
        meta["idle_minutes"] = round((time.time() - la) / 60) if la else None
        try:
            # instance.json is written at launch and not touched by Chrome
            # (which keeps rewriting files at the top of the dir).
            ref = os.path.join(d, "instance.json")
            meta["age_hours"] = round((time.time() - os.path.getmtime(ref if os.path.exists(ref) else d)) / 3600, 2)
        except OSError:
            meta["age_hours"] = None
        out.append(meta)
    return out


def cmd_attach(device, session=None, purpose=None):
    """Attach a session to the agent browser that owns DEVICE id, for agents
    that reached it with select_browser instead of `up` (a subagent handed the
    id, say). Meant for a PostToolUse hook on select_browser: then every agent
    driving a shared browser is on its card, in `list`, and counted by the
    last-out teardown. Exit 0 attached or already attached; 1 not an agent
    browser (e.g. a profile in the main Chrome)."""
    session = session or os.environ.get("CLAUDE_SESSION_ID")
    if not session:
        die("which session? pass --session or export CLAUDE_SESSION_ID")
    check_name("session", session)
    purpose = (purpose or "selected").strip()
    if not PURPOSE_RE.match(purpose):
        die("--purpose must be one word (letters, digits, - or _)")
    with slot_lock():
        m = next((x for x in instances() if x.get("device_id") == device and x["running"]), None)
        if not m:
            return 1
        if any(a.get("session") == session for a in m.get("attachments") or []):
            print(f"claude-browser: session already attached to {m['session']}")
            return 0
        att = {"session": session, "purpose": purpose, "sites": [], "identity": caller_identity(),
               "owner_pid": owner_pid(), "attached_at": time.strftime("%Y-%m-%d %H:%M:%S"), "via": "select_browser"}

        def add(mt):
            if mt.get("attached") is None:
                mt["attached"] = attachments(mt)
            mt["attached"].append(att)
        meta = update_meta(m["dir"], add)
        rewrite_card(m["dir"])
    log_event("attach", session=session, account=m.get("account"), purpose=purpose, instance=m["session"],
              via="select_browser")
    print(f"claude-browser: attached this session to the shared {m.get('account')} browser "
          f"({len(meta['attached'])} agent(s)); it shares cookies with every agent there. "
          f"Close your tab group and `claude-browser down` when done.")
    return 0


def cmd_list(as_json=False):
    rows = instances()
    if as_json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no instances")
        return 0
    print(f"{'browser':26} {'account':8} {'run':4} {'idle m':6} {'device id':38} agents")
    for m in rows:
        att = m.get("attachments") or []
        print(f"{m['session'][:26]:26} {m.get('account','?'):8} {'yes' if m['running'] else 'no':4} "
              f"{str(m.get('idle_minutes')):6} {(m.get('device_id') or '-'):38} {len(att)}")
        for a in att:
            ident = a.get("identity") or {}
            owner = {True: "alive", False: "GONE", None: "-"}[a.get("owner_alive")]
            hold = a.get("hold_until") or 0
            hold_s = f" hold {int((hold - time.time()) / 60)}m" if hold > time.time() else ""
            print(f"    {(a.get('session') or '?'):38} {(a.get('purpose') or '-')[:12]:12} owner {owner:5}{hold_s} "
                  f"from {ident.get('kind','?')}:{ident.get('pane') or '?'} sites {','.join(a.get('sites') or []) or '-'}")
    return 0


def cmd_resolve(dev):
    for m in instances():
        if m.get("device_id") == dev:
            print(f"browser {m['session']} account {m.get('account')} running={m['running']} "
                  f"agents: " + ", ".join(f"{(a.get('session') or '?')[:8]} ({a.get('purpose')}, "
                                          f"{(a.get('identity') or {}).get('kind')}:{(a.get('identity') or {}).get('pane')})"
                                          for a in m.get("attachments") or []))
            return 0
    for a in known_accounts():
        for n, d in account_slots(a).items():
            if d == dev:
                print(f"PAIRING {a} (saved pairing; no live browser holds it right now)")
                return 0
    return 1


def browser_age_s(meta, d):
    """Seconds since launch (launched_at), else since `created`. Not the dir
    mtime: atomic instance.json writes touch the directory on every attach."""
    if meta.get("launched_at"):
        return round(time.time() - meta["launched_at"])
    try:
        return round(time.time() - time.mktime(time.strptime(meta["created"], "%Y-%m-%d %H:%M:%S")))
    except (KeyError, ValueError, TypeError):
        return round(time.time() - os.path.getmtime(d))


def teardown(session, by="down"):
    d = sdir(session)
    if not os.path.isdir(d):
        return False
    if not inside(d, SESSIONS):
        # Refuse, but don't exit: gc / down --all / the up reaper call this in
        # a loop, and one stray symlink must not stop them.
        sys.stderr.write(f"refusing to tear down {d}: not inside {SESSIONS}\n")
        log_event("teardown-refused", session=session, by=by, reason="outside sessions/")
        return False
    meta = read_json(os.path.join(d, "instance.json"), {}) or {}
    pids = chrome_pids(d)
    log_event("teardown", session=session, by=by, account=meta.get("account"),
              purpose=meta.get("purpose"), was_running=bool(pids),
              age_s=browser_age_s(meta, d))
    if pids:
        kill_instance(d)
        for _ in range(20):
            if not chrome_pids(d):
                break
            time.sleep(0.5)
        if chrome_pids(d):
            kill_instance(d, 9)
            time.sleep(1)
    app = meta.get("app")
    if app and os.path.isdir(app) and inside(app, INSTANCE_APPS):
        shutil.rmtree(app, ignore_errors=True)
    # A session clone is regenerable from the base (~180 MB each), so it is
    # deleted outright; sending every ended session to the Trash just moves
    # the leak there.
    shutil.rmtree(d, ignore_errors=True)
    return True


def cmd_down(session, all_):
    if all_:
        with slot_lock():
            n = sum(1 for m in instances() if teardown(m["session"]))
        print(f"down: {n} browser(s)")
        return 0
    session = session or os.environ.get("CLAUDE_SESSION_ID")
    if not session:
        die("which session? pass <session> or export CLAUDE_SESSION_ID")
    check_name("session", session)
    if os.path.isdir(sdir(session)) and session.startswith(("acct-", "pair-")):
        with slot_lock():
            teardown(session)                  # a browser named directly: every attached agent loses it
        print(f"down: {session}")
        return 0
    with slot_lock():
        m, a = find_attached(session)
        if not m:
            print(f"down: no browser for {session}")
            return 0
        if m.get("attached") is None:          # 0.1.x per-session instance
            teardown(m["session"])
            print(f"down: {m['session']}")
            return 0
        meta = update_meta(m["dir"], lambda mt: mt.__setitem__(
            "attached", [x for x in mt.get("attached", []) if x.get("session") != session]))
        log_event("detach", session=session, instance=m["session"], by="down")
        if not meta["attached"]:
            teardown(m["session"], by="last-detach")
            print(f"down: {session} detached; last agent, {m['session']} torn down")
        else:
            rewrite_card(m["dir"])
            print(f"down: {session} detached from {m['session']} ({len(meta['attached'])} agent(s) remain)")
    return 0


def cmd_events(since_hours, as_json):
    if not os.path.exists(EVENTS):
        print("no events yet")
        return 0
    cutoff = time.time() - since_hours * 3600 if since_hours else 0
    for line in open(EVENTS):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if cutoff and time.mktime(time.strptime(r["ts"], "%Y-%m-%dT%H:%M:%S")) < cutoff:
            continue
        if as_json:
            print(json.dumps(r, sort_keys=True))
            continue
        extra = {k: v for k, v in r.items() if k not in ("ts", "event", "pid", "cli_session", "identity")}
        # Rows appended by other tools may carry whoami = "<label> : <email>  <account uuid>";
        # the uuid reads like a session id, so keep the email only.
        if isinstance(extra.get("whoami"), str) and ":" in extra["whoami"]:
            extra["whoami"] = extra["whoami"].split(":", 1)[1].split()[0]
        ident = r.get("identity") or {}
        frm = f"{ident.get('kind')}:{ident.get('pane')}" if ident else ""
        sess = r.get("cli_session") or "-"
        if len(sess) == 36 and sess.count("-") == 4:
            sess = sess[:8]          # a uuid: first 8 is how panes and cards name it
        sess = sess[:22]
        print(f"{r['ts']} {r['event']:13} {sess:22} {frm:16} " + " ".join(f"{k}={v}" for k, v in sorted(extra.items())))
    return 0


def cmd_gc(older_than):
    n = 0
    live_apps = {m.get("app") for m in instances() if m.get("app")}
    mine = set(_dock_apps())
    if os.path.isdir(INSTANCE_APPS):
        for a in os.listdir(INSTANCE_APPS):
            p = os.path.join(INSTANCE_APPS, a)
            if p not in mine:
                continue            # not created by this root: another root's (possibly live) app
            # skip apps under 10 min old: a concurrent `up` may still be building it
            try:
                young = time.time() - os.path.getmtime(p) < 600
            except OSError:
                continue
            if p.endswith(".app") and p not in live_apps and not young and inside(p, INSTANCE_APPS):
                shutil.rmtree(p, ignore_errors=True)
                print(f"gc: orphan dock app {a}")
    if mine:
        still = sorted(x for x in mine if os.path.isdir(x))
        if len(still) != len(mine):
            write_json(DOCK_APPS, still)
    with slot_lock():
        prune_attachments()
        for m in instances():
            alive = any(x.get("owner_alive") for x in m.get("attachments") or []) or held(m)
            why = reap_reason(m) or ("old" if (m.get("age_hours") or 0) >= older_than and not alive else None)
            if why and teardown(m["session"], by=f"gc-{why}"):
                n += 1
                print(f"gc: {m['session']} ({why})")
    print(f"gc: {n} removed")
    gc_identity()
    return 0


# ------------------------------------------------------------------- app copy

def build_one_app(path, icon):
    if not shutil.which("fileicon"):
        die("fileicon not installed (brew install fileicon)")
    # Match the executable, not the bundle path: a bare bundle-path match
    # catches unrelated processes.
    exe = os.path.join(path, "Contents", "MacOS", "Google Chrome")
    ps = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True).stdout
    if any(line.startswith(exe) for line in ps.splitlines()):
        die(f"{path} is running; `claude-browser down --all` first", 1)
    if os.path.isdir(path):
        if TRASH:
            subprocess.run([TRASH, path], check=False)
        else:
            shutil.rmtree(path, ignore_errors=True)
    r = subprocess.run(["cp", "-Rc", CHROME_APP_SRC, path], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"clone failed: {r.stderr.strip()}", 3)
    r = subprocess.run(["fileicon", "set", path, icon], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"fileicon failed: {r.stderr.strip()}", 3)
    ok = subprocess.run(["codesign", "--verify", path], capture_output=True).returncode == 0
    print(f"built {path} (Chrome {app_version(path)}), icon {os.path.basename(icon)}, signature valid={ok}")
    return ok


def icon_for(account=None, explicit=None):
    if explicit:
        return explicit
    out = os.path.join(ICON_DIR, f"ClaudeChrome-{account}.icns" if account else "ClaudeChrome.icns")
    ok, err = make_icon(out, account=account)
    if not ok:
        die(f"could not render {out}: {err or 'make-claude-chrome-icon failed'}\n"
            f"(needs Pillow: install uv, or `python3 -m pip install pillow`)", 3)
    return out


def cmd_app_build(icon=None, account=None, all_accounts=False):
    """(Re)create the icon-bearing Chrome copies: APFS clone of Google Chrome
    + custom Finder icon rendered from Chrome's own. Generic copy by default;
    --account A builds 'Chrome Claude <n>.app' with the account's badge; --all
    builds the generic one plus every known account. Rerun after a Chrome update."""
    if account:
        check_name("account", account)
    targets = []
    if all_accounts:
        targets.append((CHROME_APP_COPY, None))
        targets += [(os.path.join(APPS_DIR, f"Chrome Claude {account_suffix(a)}.app"), a) for a in known_accounts()]
    elif account:
        targets.append((os.path.join(APPS_DIR, f"Chrome Claude {account_suffix(account)}.app"), account))
    else:
        targets.append((CHROME_APP_COPY, None))
    os.makedirs(APPS_DIR, exist_ok=True)
    ok = True
    for path, acct in targets:
        ok = build_one_app(path, icon_for(acct, icon)) and ok
    return 0 if ok else 3


def cmd_app_check():
    apps = [CHROME_APP_COPY] + [os.path.join(APPS_DIR, f"Chrome Claude {account_suffix(a)}.app") for a in known_accounts()]
    v2 = app_version(CHROME_APP_SRC)
    rc = 0
    for p in apps:
        if not os.path.isdir(p):
            print(f"{os.path.basename(p):26} missing")
            continue
        v1 = app_version(p)
        ok = subprocess.run(["codesign", "--verify", p], capture_output=True).returncode == 0
        state = "OK" if (v1 == v2 and ok) else "REBUILD"
        rc = rc or (0 if state == "OK" else 1)
        print(f"{os.path.basename(p):26} {v1} (stock {v2}) signature={ok} {state}")
    return rc


def cmd_config(as_json=False):
    cfg = effective_config()
    if as_json:
        print(json.dumps(cfg, indent=2))
        return 0
    for k, v in cfg.items():
        print(f"{k:24} {json.dumps(v) if isinstance(v, (dict, list)) else v}")
    acct = os.environ.get("CLAUDE_BROWSER_ACCOUNT") or session_account()
    print(f"{'(this session account)':24} {acct or 'unknown — pass --account'}")
    return 0


# -------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="claude-browser", description=__doc__.split("\n")[0])
    ap.add_argument("--version", action="version", version=f"claude-browser {__version__}")
    sub = ap.add_subparsers(dest="cmd")

    t = sub.add_parser("template", help="the shared base and per-account pairing overlays")
    ts = t.add_subparsers(dest="tcmd")
    ti = ts.add_parser("init", help="create the shared base (one human click: Add to Chrome)")
    ti.add_argument("--rebuild", action="store_true",
                    help="build a new base from an empty dir and swap it in (clears any cookie the old base holds)")
    ti.add_argument("--with", dest="with_exts", action="append", default=[], metavar="EXT_ID",
                    help="with --rebuild: another Web Store extension to add (repeatable), e.g. a password manager")
    ti.add_argument("--wait", type=int, default=900)
    ae = ts.add_parser("add-extension", help="add a Web Store extension to the base (one human click), e.g. a password manager")
    ae.add_argument("extension_id")
    ae.add_argument("--wait", type=int, default=900)
    ts.add_parser("check").add_argument("account")
    ts.add_parser("list")
    pr = ts.add_parser("pair", help="add an account: clone base, sign in from main Chrome, human clicks the extension once; saves the overlay")
    pr.add_argument("account")
    pr.add_argument("--wait", type=int, default=600)
    idp = ts.add_parser("identity", help="the golden claude.ai login per account (templates/<account>/identity/)")
    ids = idp.add_subparsers(dest="icmd")
    i1 = ids.add_parser("seed", help="copy the account's claude.ai login from its main-Chrome profile (one-time migration)")
    i1.add_argument("account", nargs="?"); i1.add_argument("--all", action="store_true")
    i2 = ids.add_parser("refresh", help="open the identity hidden on claude.ai for identity_refresh_seconds, then quit")
    i2.add_argument("account", nargs="?"); i2.add_argument("--all", action="store_true")
    i2.add_argument("--if-older-than", type=float, metavar="HOURS", help="skip identities refreshed more recently")
    i3 = ids.add_parser("login", help="open the identity at claude.ai/login for a human to sign in")
    i3.add_argument("account"); i3.add_argument("--wait", type=int, default=600)

    u = sub.add_parser("up", help="attach this session to its account's browser (launching it if needed)")
    u.add_argument("--account")
    u.add_argument("--session")
    u.add_argument("--purpose", help="REQUIRED one word: what this browser is for (bank, shop, tickets…)")
    u.add_argument("--sites", help="REQUIRED unless --no-graft: comma-separated hosts whose cookies to copy in")
    u.add_argument("--origin", help="text naming where the driving agent runs (overrides pane detection)")
    u.add_argument("--hold", type=int, metavar="MINUTES",
                   help="keep the browser past the idle limit for this long (waiting on a human, max 1440); "
                        "re-run `up --hold N` in the same session to extend")
    u.add_argument("--no-graft", action="store_true")
    u.add_argument("--wait", type=int, default=300,
                   help="seconds to wait for the extension to mint its device id (0 = don't wait)")

    d = sub.add_parser("down", help="detach a session (the last one out tears the browser down)")
    d.add_argument("session", nargs="?")
    d.add_argument("--all", action="store_true")

    ev = sub.add_parser("events", help="print the event log (launches, refusals, pairings, teardowns)")
    ev.add_argument("--since", help="hours back (default all)", type=float)
    ev.add_argument("--json", action="store_true")

    l = sub.add_parser("list", help="list instances")
    l.add_argument("--json", action="store_true")

    sub.add_parser("resolve", help="which session owns a device id").add_argument("device_id")

    at = sub.add_parser("attach", help="attach a session to the agent browser with this device id (for a select_browser hook)")
    at.add_argument("--device-id", required=True)
    at.add_argument("--session")
    at.add_argument("--purpose")

    g = sub.add_parser("gc", help="remove dead or old instances")
    g.add_argument("--older-than", type=float, default=24.0, help="hours")

    c = sub.add_parser("config", help="print the effective configuration")
    c.add_argument("--json", action="store_true")


    app = sub.add_parser("app", help="the icon-bearing Chrome copies agent instances launch from")
    apps = app.add_subparsers(dest="acmd")
    ab = apps.add_parser("build"); ab.add_argument("--icon"); ab.add_argument("--account"); ab.add_argument("--all", action="store_true")
    apps.add_parser("check")

    args = ap.parse_args()
    if args.cmd == "app":
        if args.acmd == "build":
            return cmd_app_build(args.icon, args.account, args.all)
        if args.acmd == "check":
            return cmd_app_check()
        app.print_help(); return 1
    if args.cmd == "template":
        if args.tcmd == "add-extension":
            return cmd_template_add_extension(args.extension_id, args.wait)
        if args.tcmd == "init":
            if args.rebuild:
                return cmd_template_rebuild(args.with_exts, args.wait)
            if args.with_exts:
                die("--with goes with --rebuild (or use template add-extension <id>)")
            return cmd_template_init()
        if args.tcmd == "check":
            return cmd_template_check(args.account)
        if args.tcmd == "list":
            return cmd_template_list()
        if args.tcmd == "pair":
            return cmd_template_pair(args.account, args.wait)
        if args.tcmd == "identity":
            if args.icmd == "seed":
                return cmd_identity_seed(args.account, args.all)
            if args.icmd == "refresh":
                return cmd_identity_refresh(args.account, args.all, args.if_older_than)
            if args.icmd == "login":
                return cmd_identity_login(args.account, args.wait)
            idp.print_help(); return 1
        t.print_help(); return 1
    if args.cmd == "up":
        return cmd_up(args)
    if args.cmd == "down":
        return cmd_down(args.session, args.all)
    if args.cmd == "events":
        return cmd_events(args.since, args.json)
    if args.cmd == "list":
        return cmd_list(args.json)
    if args.cmd == "resolve":
        return cmd_resolve(args.device_id)
    if args.cmd == "attach":
        return cmd_attach(args.device_id, args.session, args.purpose)
    if args.cmd == "gc":
        return cmd_gc(args.older_than)
    if args.cmd == "config":
        return cmd_config(args.json)
    ap.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
